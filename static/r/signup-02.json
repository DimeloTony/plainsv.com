            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { GalleryVerticalEndIcon } from \"@lucide/svelte\";\n\timport SignupForm from \"./signup-form.svelte\";\n</script>\n\n<PageMeta title=\"Signup 02 example\" description=\"A two column sign up page with a cover image.\" />\n\n<div class=\"loginPage not-typeset\">\n\t<!-- Form column with the brand at the top. -->\n\t<div class=\"formColumn\">\n\t\t<div class=\"brandRow\">\n\t\t\t<a href=\"/\" class=\"brand\">\n\t\t\t\t<span class=\"brandLogo\"><GalleryVerticalEndIcon /></span>\n\t\t\t\tAcme Inc.\n\t\t\t</a>\n\t\t</div>\n\t\t<div class=\"formArea\">\n\t\t\t<div class=\"formAreaInner\">\n\t\t\t\t<SignupForm />\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<!-- Cover panel, shown on wide screens only. -->\n\t<div class=\"cover\" aria-hidden=\"true\"></div>\n</div>\n\n<style>\n\t/* Full-height page split into two columns on wide screens */\n\t.loginPage {\n\t\tdisplay: flex;\n\t\tmin-height: 100svh;\n\t}\n\n\t.formColumn {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-xl);\n\t}\n\n\t/* Brand link, centered on small screens and at the start on wider ones */\n\t.brandRow {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t}\n\n\t.brand {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: inherit;\n\t\tfont-weight: 500;\n\t\ttext-decoration: none;\n\t}\n\n\t.brandLogo {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-md);\n\t\tbackground-color: var(--primary);\n\t\twidth: var(--control-height-xs);\n\t\theight: var(--control-height-xs);\n\t\tcolor: var(--primary-foreground);\n\t}\n\n\t.brandLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* The form sits in the middle of the remaining space */\n\t.formArea {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t}\n\n\t.formAreaInner {\n\t\twidth: 100%;\n\t\tmax-width: 20rem; /* 320px */\n\t}\n\n\t/* Muted cover panel in place of an image */\n\t.cover {\n\t\tdisplay: none;\n\t\tflex: 1;\n\t\tbackground-color: var(--muted);\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.formColumn {\n\t\t\tpadding: calc(var(--spacing-xl) + var(--spacing-lg)); /* 40px */\n\t\t}\n\n\t\t.brandRow {\n\t\t\tjustify-content: flex-start;\n\t\t}\n\t}\n\n\t@media (min-width: 64rem) {\n\t\t.cover {\n\t\t\tdisplay: block;\n\t\t}\n\t}\n</style>\n"
        },
