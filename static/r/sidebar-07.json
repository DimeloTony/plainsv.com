            "path": "src/routes/(custom)/examples/sidebar-07/+page.svelte",
            "target": "src/routes/(blocks)/sidebar-07/+page.svelte",
            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 07 example\" description=\"A sidebar that collapses to icons.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Top bar that shrinks while the sidebar is collapsed to icons. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<div class=\"pageHeaderInner\">\n\t\t\t\t<SidebarTrigger style=\"margin-left: calc(var(--spacing-xs) * -1)\" />\n\t\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t\t<Breadcrumb>\n\t\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t\t<BreadcrumbItem class=\"hideOnMobile\"><BreadcrumbLink href=\"#\">Build Your Application</BreadcrumbLink></BreadcrumbItem>\n\t\t\t\t\t\t<BreadcrumbSeparator class=\"hideOnMobile\" />\n\t\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage>Data Fetching</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t\t</BreadcrumbList>\n\t\t\t\t</Breadcrumb>\n\t\t\t</div>\n\t\t</header>\n\n\t\t<!-- Placeholder content. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"tiles\">\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"tile tileLarge\"></div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t/* Top bar of the main content */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\ttransition: height 200ms linear;\n\t\theight: 4rem; /* 64px */\n\t}\n\n\t:global(.sidebarWrapper:has(.sidebar[data-collapsible=\"icon\"])) .pageHeader {\n\t\theight: 3rem; /* 48px */\n\t}\n\n\t.pageHeaderInner {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tpadding-inline: var(--spacing-lg);\n\t}\n\n\t/* The parent crumb only shows on wider screens */\n\t@media (max-width: 47.99rem) {\n\t\t.pageHeader :global(.hideOnMobile) {\n\t\t\tdisplay: none;\n\t\t}\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: 0 var(--spacing-lg) var(--spacing-lg);\n\t}\n\n\t/* Placeholder content blocks */\n\t.tiles {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.tile {\n\t\tflex: 1 1 12rem;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 16 / 9;\n\t}\n\n\t.tileLarge {\n\t\tflex: 1;\n\t\taspect-ratio: auto;\n\t\tmin-height: 100svh;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.tileLarge {\n\t\t\tmin-height: min-content;\n\t\t}\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-07/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-07/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarFooter, SidebarHeader, SidebarRail, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { GalleryVerticalEndIcon, AudioLinesIcon, TerminalIcon, SquareTerminalIcon, BotIcon, BookOpenIcon, Settings2Icon, FrameIcon, ChartPieIcon, MapIcon } from \"@lucide/svelte\";\n\timport TeamSwitcher from \"./team-switcher.svelte\";\n\timport NavMain from \"./nav-main.svelte\";\n\timport NavProjects from \"./nav-projects.svelte\";\n\timport NavUser from \"./nav-user.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample teams, navigation, projects, and user.\n\tconst data = {\n\t\tuser: { name: \"shadcn\", email: \"m@example.com\", initials: \"CN\" },\n\t\tteams: [\n\t\t\t{ name: \"Acme Inc\", logo: GalleryVerticalEndIcon, plan: \"Enterprise\" },\n\t\t\t{ name: \"Acme Corp.\", logo: AudioLinesIcon, plan: \"Startup\" },\n\t\t\t{ name: \"Evil Corp.\", logo: TerminalIcon, plan: \"Free\" },\n\t\t],\n\t\tnavMain: [\n\t\t\t{\n\t\t\t\ttitle: \"Playground\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: SquareTerminalIcon,\n\t\t\t\tisActive: true,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"History\", url: \"#\" },\n\t\t\t\t\t{ title: \"Starred\", url: \"#\" },\n\t\t\t\t\t{ title: \"Settings\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Models\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: BotIcon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Genesis\", url: \"#\" },\n\t\t\t\t\t{ title: \"Explorer\", url: \"#\" },\n\t\t\t\t\t{ title: \"Quantum\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Documentation\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: BookOpenIcon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Introduction\", url: \"#\" },\n\t\t\t\t\t{ title: \"Get Started\", url: \"#\" },\n\t\t\t\t\t{ title: \"Tutorials\", url: \"#\" },\n\t\t\t\t\t{ title: \"Changelog\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Settings\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: Settings2Icon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"General\", url: \"#\" },\n\t\t\t\t\t{ title: \"Team\", url: \"#\" },\n\t\t\t\t\t{ title: \"Billing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Limits\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t],\n\t\tprojects: [\n\t\t\t{ name: \"Design Engineering\", url: \"#\", icon: FrameIcon },\n\t\t\t{ name: \"Sales & Marketing\", url: \"#\", icon: ChartPieIcon },\n\t\t\t{ name: \"Travel\", url: \"#\", icon: MapIcon },\n\t\t],\n\t};\n</script>\n\n<Sidebar collapsible=\"icon\" {...props}>\n\t<!-- Team switcher. -->\n\t<SidebarHeader>\n\t\t<TeamSwitcher teams={data.teams} />\n\t</SidebarHeader>\n\n\t<!-- Platform sections and projects. -->\n\t<SidebarContent>\n\t\t<NavMain items={data.navMain} />\n\t\t<NavProjects projects={data.projects} />\n\t</SidebarContent>\n\n\t<!-- Signed-in user with an account menu. -->\n\t<SidebarFooter>\n\t\t<NavUser user={data.user} />\n\t</SidebarFooter>\n\t<SidebarRail />\n</Sidebar>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-07/nav-main.svelte",
            "target": "src/routes/(blocks)/sidebar-07/nav-main.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon } from \"@lucide/svelte\";\n\tconst { items }: Props = $props();\n\t/** Platform sections that expand into their pages */\n\tinterface Props {\n\t\t/** Sections with an icon, whether they start open, and their pages */\n\t\titems: { title: string; url: string; icon: Component; isActive?: boolean; items?: { title: string; url: string }[] }[];\n\t}\n</script>\n\n<SidebarGroup>\n\t<SidebarGroupLabel>Platform</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each items as item (item.title)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<Collapsible defaultOpen={item.isActive}>\n\t\t\t\t\t<!-- Section button; collapsed to icons, it shows its title in a tooltip. -->\n\t\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuButton tooltip={item.title} class=\"sectionButton\" {...props}>\n\t\t\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t\t\t\t<ChevronRightIcon class=\"sectionChevron\" />\n\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t\t<CollapsibleContent>\n\t\t\t\t\t\t<SidebarMenuSub>\n\t\t\t\t\t\t\t{#each item.items ?? [] as page (page.title)}\n\t\t\t\t\t\t\t\t<SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t<SidebarMenuSubButton href={page.url}><span>{page.title}</span></SidebarMenuSubButton>\n\t\t\t\t\t\t\t\t</SidebarMenuSubItem>\n\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t</SidebarMenuSub>\n\t\t\t\t\t</CollapsibleContent>\n\t\t\t\t</Collapsible>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* Chevron at the end that points down while the section is open */\n\t:global(.sidebar .sidebarMenuButton.sectionButton .sectionChevron) {\n\t\ttransition: transform 200ms ease;\n\t\tmargin-left: auto;\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.sectionButton[data-state=\"open\"] .sectionChevron) {\n\t\ttransform: rotate(90deg);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-07/nav-projects.svelte",
            "target": "src/routes/(blocks)/sidebar-07/nav-projects.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { EllipsisIcon, FolderIcon, ArrowRightIcon, Trash2Icon } from \"@lucide/svelte\";\n\tconst { projects }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Project links with a menu of actions on each; hidden while collapsed to icons */\n\tinterface Props {\n\t\t/** Projects with their icons */\n\t\tprojects: { name: string; url: string; icon: Component }[];\n\t}\n</script>\n\n<SidebarGroup class=\"projectsGroup\">\n\t<SidebarGroupLabel>Projects</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each projects as item (item.name)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton href={item.url}>\n\t\t\t\t\t<item.icon />\n\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t<!-- Actions menu; opens below on mobile and beside the sidebar on desktop. -->\n\t\t\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align={sidebar.isMobile ? \"end\" : \"start\"}>\n\t\t\t\t\t<DropdownMenuTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"projectAction\" aria-label=\"More for {item.name}\" {...props}><EllipsisIcon /></SidebarMenuAction>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</DropdownMenuTrigger>\n\t\t\t\t\t<DropdownMenuContent>\n\t\t\t\t\t\t<DropdownMenuItem><FolderIcon /> View Project</DropdownMenuItem>\n\t\t\t\t\t\t<DropdownMenuItem><ArrowRightIcon /> Share Project</DropdownMenuItem>\n\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t<DropdownMenuItem variant=\"destructive\"><Trash2Icon /> Delete Project</DropdownMenuItem>\n\t\t\t\t\t</DropdownMenuContent>\n\t\t\t\t</DropdownMenu>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\n\t\t<!-- Muted link to the rest of the projects. -->\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton class=\"moreButton\">\n\t\t\t\t<EllipsisIcon />\n\t\t\t\t<span>More</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* Collapsed to icons, the projects hide */\n\t:global(.sidebar[data-collapsible=\"icon\"] .sidebarGroup.projectsGroup) {\n\t\tdisplay: none;\n\t}\n\n\t/* The action stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuAction.projectAction[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.moreButton) {\n\t\tcolor: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-07/nav-user.svelte",
            "target": "src/routes/(blocks)/sidebar-07/nav-user.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { Avatar, AvatarFallback } from \"#lib/components/ui/avatar/index.js\";\n\timport { ChevronsUpDownIcon, SparklesIcon, BadgeCheckIcon, CreditCardIcon, BellIcon, LogOutIcon } from \"@lucide/svelte\";\n\tconst { user }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Signed-in user shown in the sidebar footer */\n\tinterface Props {\n\t\t/** Name, email, and avatar initials */\n\t\tuser: { name: string; email: string; initials: string };\n\t}\n</script>\n\n<SidebarMenu>\n\t<SidebarMenuItem>\n\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align=\"end\" sideOffset={4}>\n\t\t\t<!-- User button with the avatar, name, and email. -->\n\t\t\t<DropdownMenuTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarMenuButton size=\"lg\" class=\"userButton\" {...props}>\n\t\t\t\t\t\t<Avatar size=\"sm\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<ChevronsUpDownIcon class=\"userChevron\" />\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t{/snippet}\n\t\t\t</DropdownMenuTrigger>\n\n\t\t\t<!-- Account menu. -->\n\t\t\t<DropdownMenuContent style=\"min-width: 14rem\">\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuLabel>\n\t\t\t\t\t\t<span class=\"userLabel\">\n\t\t\t\t\t\t\t<Avatar size=\"sm\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</DropdownMenuLabel>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><SparklesIcon /> Upgrade to Pro</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><BadgeCheckIcon /> Account</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><CreditCardIcon /> Billing</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><BellIcon /> Notifications</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuItem><LogOutIcon /> Log out</DropdownMenuItem>\n\t\t\t</DropdownMenuContent>\n\t\t</DropdownMenu>\n\t</SidebarMenuItem>\n</SidebarMenu>\n\n<style>\n\t/* Name above the email, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tfont-size: var(--text-sm);\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n\n\t/* Avatar and text in the menu heading */\n\t.userLabel {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: var(--foreground);\n\t\tfont-weight: 400;\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.userButton .userChevron) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The button stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuButton.userButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-07/team-switcher.svelte",
            "target": "src/routes/(blocks)/sidebar-07/team-switcher.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuLabel, DropdownMenuItem, DropdownMenuSeparator, DropdownMenuShortcut } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { ChevronsUpDownIcon, PlusIcon } from \"@lucide/svelte\";\n\tconst { teams }: Props = $props();\n\tconst sidebar = useSidebar();\n\tlet activeTeam = $state(teams[0]);\n\t/** Teams the user can switch between */\n\tinterface Props {\n\t\t/** Teams with their logo and plan */\n\t\tteams: { name: string; logo: Component; plan: string }[];\n\t}\n</script>\n\n<SidebarMenu>\n\t<SidebarMenuItem>\n\t\t<DropdownMenu align=\"start\" side={sidebar.isMobile ? \"bottom\" : \"right\"} sideOffset={4}>\n\t\t\t<!-- Active team with its logo and plan. -->\n\t\t\t<DropdownMenuTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarMenuButton size=\"lg\" class=\"teamButton\" {...props}>\n\t\t\t\t\t\t<span class=\"teamLogo\"><activeTeam.logo /></span>\n\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t<strong>{activeTeam.name}</strong>\n\t\t\t\t\t\t\t<span>{activeTeam.plan}</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<ChevronsUpDownIcon class=\"teamChevron\" />\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t{/snippet}\n\t\t\t</DropdownMenuTrigger>\n\n\t\t\t<!-- Teams, then an add action. -->\n\t\t\t<DropdownMenuContent style=\"min-width: 14rem\">\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuLabel>Teams</DropdownMenuLabel>\n\t\t\t\t\t{#each teams as team, index (team.name)}\n\t\t\t\t\t\t<DropdownMenuItem onSelect={() => (activeTeam = team)}>\n\t\t\t\t\t\t\t<span class=\"teamItemLogo\"><team.logo /></span>\n\t\t\t\t\t\t\t{team.name}\n\t\t\t\t\t\t\t<DropdownMenuShortcut>⌘{index + 1}</DropdownMenuShortcut>\n\t\t\t\t\t\t</DropdownMenuItem>\n\t\t\t\t\t{/each}\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem>\n\t\t\t\t\t\t<span class=\"teamItemLogo\"><PlusIcon /></span>\n\t\t\t\t\t\t<span class=\"addTeam\">Add team</span>\n\t\t\t\t\t</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t</DropdownMenuContent>\n\t\t</DropdownMenu>\n\t</SidebarMenuItem>\n</SidebarMenu>\n\n<style>\n\t/* Square team logo */\n\t.teamLogo {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-lg);\n\t\tbackground-color: var(--sidebar-primary);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.teamLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* Name above the plan, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.teamButton .teamChevron) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The button stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuButton.teamButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--sidebar-accent);\n\t\tcolor: var(--sidebar-accent-foreground);\n\t}\n\n\t/* Bordered logo box in the menu */\n\t.teamItemLogo {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder: 1px solid var(--border);\n\t\tborder-radius: var(--radius-md);\n\t\twidth: var(--control-height-xs);\n\t\theight: var(--control-height-xs);\n\t}\n\n\t.addTeam {\n\t\tcolor: var(--muted-foreground);\n\t\tfont-weight: 500;\n\t}\n</style>\n"
        }
    ],
    "itemDependencies": [
        "/r/sidebar.json",
        "/r/breadcrumb.json",
        "/r/separator.json",
        "/r/collapsible.json",
        "/r/dropdown-menu.json",
        "/r/avatar.json"
    ],
    "devDependencies": [
        "@lucide/svelte"
    ],
    "description": "A sidebar that collapses to icons."
}