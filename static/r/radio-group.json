            "content": "<script lang=\"ts\">\n\timport { setCompCtx } from \"./ctx.svelte.js\";\n\timport type { Props } from \"./index.js\";\n\timport type { CompCtxProps } from \"./ctx.svelte.js\";\n\tlet { defaultValue = \"\", value = $bindable(defaultValue), onValueChange, name, disabled = false, orientation = \"vertical\", size = \"md\", children, onkeydown, class: className, ...props }: Props = $props();\n\tconst contextData: Omit<CompCtxProps, \"value\"> = $derived({ disabled, size, onValueChange });\n\tconst ctx = setCompCtx({ ...contextData, value });\n\n\t// Keep the shared settings in sync when the props change.\n\t$effect.pre(() => void Object.assign(ctx, contextData));\n\n\t// Keep the bindable prop and the shared value in sync in both directions.\n\t$effect.pre(() => void (ctx.value = value));\n\t$effect.pre(() => void (value = ctx.value));\n\n\t/** Moves focus to the previous or next item with the arrow keys and checks it, like native radio buttons. */\n\tconst handleKeydown = (e: KeyboardEvent & { currentTarget: HTMLDivElement }) => {\n\t\tonkeydown?.(e);\n\t\t// If a passed handler prevented the default: leave the key alone.\n\t\tif (e.defaultPrevented) return;\n\t\tconst items = [...e.currentTarget.querySelectorAll<HTMLButtonElement>('[role=\"radio\"]:not(:disabled)')];\n\t\tconst currentIndex = items.findIndex((item) => item === document.activeElement);\n\t\t// If focus is not on an enabled item: leave the key alone.\n\t\tif (currentIndex === -1) return;\n\t\t// Both arrow axes move, and wrap around at the ends.\n\t\tconst keyIndexes: Record<string, number> = {\n\t\t\tArrowUp: (currentIndex - 1 + items.length) % items.length,\n\t\t\tArrowLeft: (currentIndex - 1 + items.length) % items.length,\n\t\t\tArrowDown: (currentIndex + 1) % items.length,\n\t\t\tArrowRight: (currentIndex + 1) % items.length,\n\t\t};\n\t\tconst nextItem = items[keyIndexes[e.key]];\n\t\t// If the key does not move between items: let it through.\n\t\tif (!nextItem) return;\n\t\te.preventDefault();\n\t\tnextItem.focus();\n\t\tnextItem.click();\n\t};\n</script>\n\n<!-- Radio group; only the checked item is in the tab order. -->\n<div class={[\"radioGroup not-typeset\", className]} role=\"radiogroup\" aria-orientation={orientation} aria-disabled={disabled || undefined} data-orientation={orientation} data-size={size} onkeydown={handleKeydown} {...props}>\n\t{@render children()}\n</div>\n\n<!-- Submit the checked value like a native radio group. -->\n{#if name && ctx.value}\n\t<input type=\"hidden\" {name} value={ctx.value} />\n{/if}\n\n<style>\n\t/* Base group; items stack */\n\t.radioGroup {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t}\n\n\t/* Items sit in a row and wrap */\n\t.radioGroup[data-orientation=\"horizontal\"] {\n\t\tflex-direction: row;\n\t\tflex-wrap: wrap;\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.radioGroup[data-size=\"lg\"] {\n\t\tgap: var(--spacing-md);\n\t}\n\n\t/* Medium — default */\n\t.radioGroup[data-size=\"md\"] {\n\t\tgap: var(--spacing-md);\n\t}\n\n\t/* Small */\n\t.radioGroup[data-size=\"sm\"] {\n\t\tgap: var(--spacing-sm);\n\t}\n\n\t/* Extra small */\n\t.radioGroup[data-size=\"xs\"] {\n\t\tgap: var(--spacing-sm);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/radio-group/ctx.svelte.ts",
            "content": "import { setContext, getContext } from \"svelte\";\nimport type { Props } from \"./index.js\";\n\nconst CONTEXT_ID = \"radio-group-context\";\n\nclass UseCompCtx {\n\t/** Value of the checked item; empty while none is checked */\n\tvalue = $state(\"\");\n\t/** Disables every item */\n\tdisabled = $state(false);\n\t/** Circle and dot size of the items */\n\tsize: UiSize = $state(\"md\");\n\t/** Called with the new value when an item is checked */\n\tonValueChange?: Props[\"onValueChange\"];\n\n\t// Set default data\n\tconstructor(props: { [key: string]: any }) {\n\t\t// Merge props into this instance (we do not use `Object.assign(this, props)` to ensure only setting props that exists)\n\t\tfor (const [key, data] of Object.entries(props)) {\n\t\t\t// @ts-ignore\n\t\t\tif (this[key] !== undefined) this[key] = data;\n\t\t}\n\t}\n\n\t/** Checks an item and reports the change. */\n\tselect(value: string) {\n\t\t// If the item is already checked: skip the update.\n\t\tif (value === this.value) return;\n\t\tthis.value = value;\n\t\tthis.onValueChange?.(value);\n\t}\n}\n\nexport type CompCtxProps = Pick<InstanceType<typeof UseCompCtx>, \"value\" | \"disabled\" | \"size\" | \"onValueChange\">;\n\nexport const setCompCtx = (props: CompCtxProps) => setContext(CONTEXT_ID, new UseCompCtx(props));\n\nexport const useCompCtx = () => getContext<ReturnType<typeof setCompCtx>>(CONTEXT_ID);\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/radio-group/index.ts",
            "content": "export { default as RadioGroup } from \"./_.svelte\";\nexport { default as RadioGroupItem } from \"./item.svelte\";\n\n/** Set of options where only one can be checked */\nexport interface Props extends CompPropsWithChild<\"div\"> {\n\t/** Value of the checked item; supports `bind:value` */\n\tvalue?: string;\n\t/** Starting item when `value` is not set */\n\tdefaultValue?: string;\n\t/** Called with the new value when an item is checked */\n\tonValueChange?: (value: string) => void;\n\t/** Form field name; submits the checked value */\n\tname?: string;\n\t/** Disables every item */\n\tdisabled?: boolean;\n\t/** Direction the items are laid out in; the arrow keys work in both directions either way; defaults to `vertical` */\n\torientation?: \"horizontal\" | \"vertical\";\n\t/** Circle, dot, and gap size on the shared scale; defaults to `md` */\n\tsize?: UiSize;\n\t/** Classes merged onto the group */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Circle that checks its `value` in the group; renders a `button` with `role=\"radio\"` */\nexport interface ItemProps extends CompProps<\"button\"> {\n\t/** Value checked when this item is picked */\n\tvalue: string;\n\t/** Size of this item; overrides the group's `size` */\n\tsize?: UiSize;\n\t/** Classes merged onto the item */\n\tclass?: CompProps<\"button\">[\"class\"];\n}\n\nexport type RadioGroupProps = Props;\nexport type RadioGroupItemProps = ItemProps;\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/radio-group/item.svelte",
            "content": "<script lang=\"ts\">\n\timport { useCompCtx } from \"./ctx.svelte.js\";\n\timport type { ItemProps } from \"./index.js\";\n\tconst { value, size, disabled, onclick, class: className, ...props }: ItemProps = $props();\n\tconst ctx = useCompCtx();\n\tconst isChecked = $derived(ctx.value === value);\n\tconst isDisabled = $derived(ctx.disabled || !!disabled);\n\t// Only the checked item is in the tab order; when none is checked, every item stays reachable.\n\tconst tabIndex = $derived(isChecked || !ctx.value ? 0 : -1);\n\n\t/** Checks this item, unless a passed click handler prevented the default. */\n\tconst handleClick = (e: MouseEvent) => {\n\t\tonclick?.(e);\n\t\t// If the passed handler called preventDefault: keep the current item.\n\t\tif (e.defaultPrevented) return;\n\t\tctx.select(value);\n\t};\n</script>\n\n<!-- Circle that shows a dot while checked. -->\n<button type=\"button\" class={[\"radioGroupItem\", className]} role=\"radio\" aria-checked={isChecked} tabindex={tabIndex} disabled={isDisabled} data-state={isChecked ? \"checked\" : \"unchecked\"} data-size={size ?? ctx.size} onclick={handleClick} {...props}>\n\t{#if isChecked}\n\t\t<span class=\"radioGroupIndicator\" aria-hidden=\"true\"></span>\n\t{/if}\n</button>\n\n<style>\n\t/* Base item; always a circle */\n\t.radioGroupItem {\n\t\tdisplay: inline-flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\ttransition-duration: 150ms;\n\t\ttransition-property: color, border-color, box-shadow;\n\t\ttransition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n\t\tcursor: pointer;\n\t\tbox-sizing: border-box;\n\t\toutline: none;\n\t\tbox-shadow: 0 1px 2px 0 color-mix(in oklab, var(--foreground) 5%, transparent);\n\t\tborder: 1px solid var(--input);\n\t\tborder-radius: var(--radius-pill);\n\t\tbackground-color: transparent;\n\t\tpadding: 0;\n\t}\n\n\t:global(.dark) .radioGroupItem {\n\t\tbackground-color: color-mix(in oklab, var(--input) 30%, transparent);\n\t}\n\n\t/* Filled dot in the center */\n\t.radioGroupIndicator {\n\t\tborder-radius: var(--radius-pill);\n\t\tbackground-color: var(--primary);\n\t}\n\n\t/* =============== States =============== */\n\n\t/* Keyboard focus ring */\n\t.radioGroupItem:focus-visible {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);\n\t\tborder-color: var(--ring);\n\t}\n\n\t/* Invalid state from aria-invalid */\n\t.radioGroupItem[aria-invalid=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 20%, transparent);\n\t\tborder-color: var(--destructive);\n\t}\n\n\t:global(.dark) .radioGroupItem[aria-invalid=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 40%, transparent);\n\t}\n\n\t/* Disabled state */\n\t.radioGroupItem:disabled {\n\t\topacity: 50%;\n\t\tcursor: not-allowed;\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.radioGroupItem[data-size=\"lg\"] {\n\t\twidth: 1.25rem; /* 20px */\n\t\theight: 1.25rem; /* 20px */\n\t}\n\n\t.radioGroupItem[data-size=\"lg\"] .radioGroupIndicator {\n\t\twidth: 0.625rem; /* 10px */\n\t\theight: 0.625rem; /* 10px */\n\t}\n\n\t/* Medium — default */\n\t.radioGroupItem[data-size=\"md\"] {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t.radioGroupItem[data-size=\"md\"] .radioGroupIndicator {\n\t\twidth: 0.5rem; /* 8px */\n\t\theight: 0.5rem; /* 8px */\n\t}\n\n\t/* Small */\n\t.radioGroupItem[data-size=\"sm\"] {\n\t\twidth: 0.875rem; /* 14px */\n\t\theight: 0.875rem; /* 14px */\n\t}\n\n\t.radioGroupItem[data-size=\"sm\"] .radioGroupIndicator {\n\t\twidth: 0.375rem; /* 6px */\n\t\theight: 0.375rem; /* 6px */\n\t}\n\n\t/* Extra small */\n\t.radioGroupItem[data-size=\"xs\"] {\n\t\twidth: 0.75rem; /* 12px */\n\t\theight: 0.75rem; /* 12px */\n\t}\n\n\t.radioGroupItem[data-size=\"xs\"] .radioGroupIndicator {\n\t\twidth: 0.375rem; /* 6px */\n\t\theight: 0.375rem; /* 6px */\n\t}\n</style>\n"
        }
    ],
    "description": "A set of options where only one can be checked, with keyboard support, form submission, and sizes."
