            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 11 example\" description=\"A sidebar with a collapsible file tree.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Top bar with the sidebar toggle and the open file's path. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<SidebarTrigger style=\"margin-left: calc(var(--spacing-xs) * -1)\" />\n\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t<Breadcrumb>\n\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t<BreadcrumbItem class=\"hideOnMobile\"><BreadcrumbLink href=\"#\">components</BreadcrumbLink></BreadcrumbItem>\n\t\t\t\t\t<BreadcrumbSeparator class=\"hideOnMobile\" />\n\t\t\t\t\t<BreadcrumbItem class=\"hideOnMobile\"><BreadcrumbLink href=\"#\">ui</BreadcrumbLink></BreadcrumbItem>\n\t\t\t\t\t<BreadcrumbSeparator class=\"hideOnMobile\" />\n\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage>button.tsx</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t</BreadcrumbList>\n\t\t\t</Breadcrumb>\n\t\t</header>\n\n\t\t<!-- Placeholder content. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"tiles\">\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"tile tileLarge\"></div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t/* Top bar of the main content */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tborder-bottom: 1px solid var(--border);\n\t\tpadding-inline: var(--spacing-lg);\n\t\theight: 4rem; /* 64px */\n\t}\n\n\t/* The parent crumb only shows on wider screens */\n\t@media (max-width: 47.99rem) {\n\t\t.pageHeader :global(.hideOnMobile) {\n\t\t\tdisplay: none;\n\t\t}\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* Placeholder content blocks */\n\t.tiles {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.tile {\n\t\tflex: 1 1 12rem;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 16 / 9;\n\t}\n\n\t.tileLarge {\n\t\tflex: 1;\n\t\taspect-ratio: auto;\n\t\tmin-height: 100svh;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.tileLarge {\n\t\t\tmin-height: min-content;\n\t\t}\n\t}\n</style>\n"
        },
