            "path": "src/routes/(custom)/examples/sidebar-12/+page.svelte",
            "target": "src/routes/(blocks)/sidebar-12/+page.svelte",
            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbPage } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n\t// One placeholder per day in the grid.\n\tconst days = Array.from({ length: 20 }, (_, index) => index);\n</script>\n\n<PageMeta title=\"Sidebar 12 example\" description=\"A sidebar with a calendar.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Sticky top bar with the sidebar toggle and the shown month. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<SidebarTrigger style=\"margin-left: calc(var(--spacing-xs) * -1)\" />\n\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t<Breadcrumb>\n\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage>October 2024</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t</BreadcrumbList>\n\t\t\t</Breadcrumb>\n\t\t</header>\n\n\t\t<!-- Placeholder days. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"days\">\n\t\t\t\t{#each days as day (day)}\n\t\t\t\t\t<div class=\"day\"></div>\n\t\t\t\t{/each}\n\t\t\t</div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t/* Top bar that stays in view while the content scrolls */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tposition: sticky;\n\t\ttop: 0;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tz-index: 1;\n\t\tborder-bottom: 1px solid var(--border);\n\t\tbackground-color: var(--background);\n\t\tpadding-inline: var(--spacing-lg);\n\t\theight: 4rem; /* 64px */\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* One day per row on small screens, five on wider ones */\n\t.days {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.day {\n\t\tflex: 1 1 100%;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 1;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.day {\n\t\t\tflex-basis: calc(20% - var(--spacing-lg));\n\t\t}\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-12/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-12/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarFooter, SidebarHeader, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarRail, SidebarSeparator, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { PlusIcon } from \"@lucide/svelte\";\n\timport NavUser from \"./nav-user.svelte\";\n\timport DatePicker from \"./date-picker.svelte\";\n\timport Calendars from \"./calendars.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample user and calendar lists.\n\tconst data = {\n\t\tuser: { name: \"shadcn\", email: \"m@example.com\", initials: \"CN\" },\n\t\tcalendars: [\n\t\t\t{ name: \"My Calendars\", items: [\"Personal\", \"Work\", \"Family\"] },\n\t\t\t{ name: \"Favorites\", items: [\"Holidays\", \"Birthdays\"] },\n\t\t\t{ name: \"Other\", items: [\"Travel\", \"Reminders\", \"Deadlines\"] },\n\t\t],\n\t};\n</script>\n\n<Sidebar {...props}>\n\t<!-- Signed-in user, as tall as the page header. -->\n\t<SidebarHeader class=\"userHeader\">\n\t\t<NavUser user={data.user} />\n\t</SidebarHeader>\n\n\t<!-- Month calendar and the calendar lists. -->\n\t<SidebarContent>\n\t\t<DatePicker />\n\t\t<SidebarSeparator style=\"margin-inline: 0\" />\n\t\t<Calendars calendars={data.calendars} />\n\t</SidebarContent>\n\n\t<!-- New calendar action. -->\n\t<SidebarFooter>\n\t\t<SidebarMenu>\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton>\n\t\t\t\t\t<PlusIcon />\n\t\t\t\t\t<span>New Calendar</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t</SidebarFooter>\n\t<SidebarRail />\n</Sidebar>\n\n<style>\n\t:global(.sidebar .sidebarHeader.userHeader) {\n\t\tjustify-content: center;\n\t\tborder-bottom: 1px solid var(--sidebar-border);\n\t\theight: 4rem; /* 64px */\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-12/calendars.svelte",
            "target": "src/routes/(blocks)/sidebar-12/calendars.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarSeparator } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon, CheckIcon } from \"@lucide/svelte\";\n\tconst { calendars }: Props = $props();\n\t/** Calendar lists whose label opens and closes them */\n\tinterface Props {\n\t\t/** Lists with the calendars in each */\n\t\tcalendars: { name: string; items: string[] }[];\n\t}\n</script>\n\n{#each calendars as calendar, index (calendar.name)}\n\t<SidebarGroup>\n\t\t<Collapsible defaultOpen={index === 0}>\n\t\t\t<!-- The label is the toggle. -->\n\t\t\t<CollapsibleTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarGroupLabel class=\"calendarsToggle\" {...props}>\n\t\t\t\t\t\t{calendar.name}\n\t\t\t\t\t\t<ChevronRightIcon class=\"calendarsChevron\" />\n\t\t\t\t\t</SidebarGroupLabel>\n\t\t\t\t{/snippet}\n\t\t\t</CollapsibleTrigger>\n\t\t\t<CollapsibleContent>\n\t\t\t\t<SidebarGroupContent>\n\t\t\t\t\t<SidebarMenu>\n\t\t\t\t\t\t{#each calendar.items as item, itemIndex (item)}\n\t\t\t\t\t\t\t<!-- The first two calendars of each list are shown. -->\n\t\t\t\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t\t\t\t<SidebarMenuButton>\n\t\t\t\t\t\t\t\t\t<span class=\"calendarCheck\" data-active={itemIndex < 2 || undefined}><CheckIcon /></span>\n\t\t\t\t\t\t\t\t\t<span>{item}</span>\n\t\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t\t</SidebarMenuItem>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</SidebarMenu>\n\t\t\t\t</SidebarGroupContent>\n\t\t\t</CollapsibleContent>\n\t\t</Collapsible>\n\t</SidebarGroup>\n\t<SidebarSeparator style=\"margin-inline: 0\" />\n{/each}\n\n<style>\n\t/* The toggle uses the full text size and color */\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle) {\n\t\tcolor: var(--sidebar-foreground);\n\t\tfont-size: var(--text-sm);\n\t}\n\n\t/* Chevron at the end that points down while the list is open */\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle .calendarsChevron) {\n\t\ttransition: transform 200ms ease;\n\t\tmargin-left: auto;\n\t}\n\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle[data-state=\"open\"] .calendarsChevron) {\n\t\ttransform: rotate(90deg);\n\t}\n\n\t/* Check box that fills with the primary color while the calendar is shown */\n\t.calendarCheck {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder: 1px solid var(--sidebar-border);\n\t\tborder-radius: var(--radius-sm);\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.calendarCheck :global(svg) {\n\t\tdisplay: none;\n\t\twidth: 0.75rem; /* 12px */\n\t\theight: 0.75rem; /* 12px */\n\t}\n\n\t.calendarCheck[data-active] {\n\t\tborder-color: var(--sidebar-primary);\n\t\tbackground-color: var(--sidebar-primary);\n\t}\n\n\t.calendarCheck[data-active] :global(svg) {\n\t\tdisplay: block;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-12/date-picker.svelte",
            "target": "src/routes/(blocks)/sidebar-12/date-picker.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Calendar } from \"#lib/components/ui/calendar/index.js\";\n\t// The 12th of this month starts selected.\n\tconst today = new Date();\n\tlet date = $state(new Date(today.getFullYear(), today.getMonth(), 12));\n</script>\n\n<!-- Month calendar with month and year selects, on the sidebar background. -->\n<SidebarGroup style=\"padding-inline: 0\">\n\t<SidebarGroupContent>\n\t\t<Calendar bind:value={date} captionLayout=\"dropdown\" variant=\"ghost\" style=\"margin-inline: auto\" />\n\t</SidebarGroupContent>\n</SidebarGroup>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-12/nav-user.svelte",
            "target": "src/routes/(blocks)/sidebar-12/nav-user.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { Avatar, AvatarFallback } from \"#lib/components/ui/avatar/index.js\";\n\timport { ChevronsUpDownIcon, SparklesIcon, BadgeCheckIcon, CreditCardIcon, BellIcon, LogOutIcon } from \"@lucide/svelte\";\n\tconst { user }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Signed-in user shown in the sidebar footer */\n\tinterface Props {\n\t\t/** Name, email, and avatar initials */\n\t\tuser: { name: string; email: string; initials: string };\n\t}\n</script>\n\n<SidebarMenu>\n\t<SidebarMenuItem>\n\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align=\"start\" sideOffset={4}>\n\t\t\t<!-- User button with the avatar, name, and email. -->\n\t\t\t<DropdownMenuTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarMenuButton size=\"lg\" class=\"userButton\" {...props}>\n\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<ChevronsUpDownIcon class=\"userChevron\" />\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t{/snippet}\n\t\t\t</DropdownMenuTrigger>\n\n\t\t\t<!-- Account menu. -->\n\t\t\t<DropdownMenuContent style=\"min-width: 14rem\">\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuLabel>\n\t\t\t\t\t\t<span class=\"userLabel\">\n\t\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</DropdownMenuLabel>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><SparklesIcon /> Upgrade to Pro</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><BadgeCheckIcon /> Account</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><CreditCardIcon /> Billing</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><BellIcon /> Notifications</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuItem><LogOutIcon /> Log out</DropdownMenuItem>\n\t\t\t</DropdownMenuContent>\n\t\t</DropdownMenu>\n\t</SidebarMenuItem>\n</SidebarMenu>\n\n<style>\n\t/* Name above the email, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tfont-size: var(--text-sm);\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n\n\t/* Avatar and text in the menu heading */\n\t.userLabel {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: var(--foreground);\n\t\tfont-weight: 400;\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.userButton .userChevron) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The button stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuButton.userButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--sidebar-accent);\n\t\tcolor: var(--sidebar-accent-foreground);\n\t}\n</style>\n"
        }
    ],
    "itemDependencies": [
        "/r/sidebar.json",
        "/r/breadcrumb.json",
        "/r/separator.json",
        "/r/collapsible.json",
        "/r/calendar.json",
