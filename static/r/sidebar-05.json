            "path": "src/routes/(custom)/examples/sidebar-05/+page.svelte",
            "target": "src/routes/(blocks)/sidebar-05/+page.svelte",
            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 05 example\" description=\"A sidebar with collapsible submenus.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Top bar with the sidebar toggle and the current location. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<SidebarTrigger style=\"margin-left: calc(var(--spacing-xs) * -1)\" />\n\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t<Breadcrumb>\n\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t<BreadcrumbItem class=\"hideOnMobile\"><BreadcrumbLink href=\"#\">Build Your Application</BreadcrumbLink></BreadcrumbItem>\n\t\t\t\t\t<BreadcrumbSeparator class=\"hideOnMobile\" />\n\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage>Data Fetching</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t</BreadcrumbList>\n\t\t\t</Breadcrumb>\n\t\t</header>\n\n\t\t<!-- Placeholder content. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"tiles\">\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"tile tileLarge\"></div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t/* Top bar of the main content */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tborder-bottom: 1px solid var(--border);\n\t\tpadding-inline: var(--spacing-lg);\n\t\theight: 4rem; /* 64px */\n\t}\n\n\t/* The parent crumb only shows on wider screens */\n\t@media (max-width: 47.99rem) {\n\t\t.pageHeader :global(.hideOnMobile) {\n\t\t\tdisplay: none;\n\t\t}\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* Placeholder content blocks */\n\t.tiles {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.tile {\n\t\tflex: 1 1 12rem;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 16 / 9;\n\t}\n\n\t.tileLarge {\n\t\tflex: 1;\n\t\taspect-ratio: auto;\n\t\tmin-height: 100svh;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.tileLarge {\n\t\t\tmin-height: min-content;\n\t\t}\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-05/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-05/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarGroup, SidebarHeader, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem, SidebarRail, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { GalleryVerticalEndIcon, PlusIcon, MinusIcon } from \"@lucide/svelte\";\n\timport SearchForm from \"./search-form.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample docs navigation, grouped by section.\n\tconst data = {\n\t\tnavMain: [\n\t\t\t{\n\t\t\t\ttitle: \"Getting Started\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Installation\", url: \"#\" },\n\t\t\t\t\t{ title: \"Project Structure\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Build Your Application\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Routing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Data Fetching\", url: \"#\", isActive: true },\n\t\t\t\t\t{ title: \"Rendering\", url: \"#\" },\n\t\t\t\t\t{ title: \"Caching\", url: \"#\" },\n\t\t\t\t\t{ title: \"Styling\", url: \"#\" },\n\t\t\t\t\t{ title: \"Optimizing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Configuring\", url: \"#\" },\n\t\t\t\t\t{ title: \"Testing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Authentication\", url: \"#\" },\n\t\t\t\t\t{ title: \"Deploying\", url: \"#\" },\n\t\t\t\t\t{ title: \"Upgrading\", url: \"#\" },\n\t\t\t\t\t{ title: \"Examples\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"API Reference\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Components\", url: \"#\" },\n\t\t\t\t\t{ title: \"File Conventions\", url: \"#\" },\n\t\t\t\t\t{ title: \"Functions\", url: \"#\" },\n\t\t\t\t\t{ title: \"next.config.js Options\", url: \"#\" },\n\t\t\t\t\t{ title: \"CLI\", url: \"#\" },\n\t\t\t\t\t{ title: \"Edge Runtime\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Architecture\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Accessibility\", url: \"#\" },\n\t\t\t\t\t{ title: \"Fast Refresh\", url: \"#\" },\n\t\t\t\t\t{ title: \"Next.js Compiler\", url: \"#\" },\n\t\t\t\t\t{ title: \"Supported Browsers\", url: \"#\" },\n\t\t\t\t\t{ title: \"Turbopack\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Community\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [{ title: \"Contribution Guide\", url: \"#\" }],\n\t\t\t},\n\t\t],\n\t};\n</script>\n\n<Sidebar {...props}>\n\t<!-- Docs logo, version, and search. -->\n\t<SidebarHeader>\n\t\t<SidebarMenu>\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton size=\"lg\" href=\"#\">\n\t\t\t\t\t<span class=\"docsLogo\"><GalleryVerticalEndIcon /></span>\n\t\t\t\t\t<span class=\"docsTitle\">\n\t\t\t\t\t\t<strong>Documentation</strong>\n\t\t\t\t\t\t<span>v1.0.0</span>\n\t\t\t\t\t</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t\t<SearchForm />\n\t</SidebarHeader>\n\n\t<!-- Sections that expand into their pages; the second one starts open. -->\n\t<SidebarContent>\n\t\t<SidebarGroup>\n\t\t\t<SidebarMenu>\n\t\t\t\t{#each data.navMain as section, index (section.title)}\n\t\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t\t<Collapsible defaultOpen={index === 1}>\n\t\t\t\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t\t\t\t{#snippet trigger({ props: triggerProps })}\n\t\t\t\t\t\t\t\t\t<SidebarMenuButton class=\"sectionToggle\" {...triggerProps}>\n\t\t\t\t\t\t\t\t\t\t{section.title}\n\t\t\t\t\t\t\t\t\t\t<PlusIcon class=\"sectionPlus\" />\n\t\t\t\t\t\t\t\t\t\t<MinusIcon class=\"sectionMinus\" />\n\t\t\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t\t\t\t{#if section.items.length}\n\t\t\t\t\t\t\t\t<CollapsibleContent>\n\t\t\t\t\t\t\t\t\t<SidebarMenuSub>\n\t\t\t\t\t\t\t\t\t\t{#each section.items as item (item.title)}\n\t\t\t\t\t\t\t\t\t\t\t<SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t\t\t\t<SidebarMenuSubButton href={item.url} isActive={item.isActive}>{item.title}</SidebarMenuSubButton>\n\t\t\t\t\t\t\t\t\t\t\t</SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t\t</SidebarMenuSub>\n\t\t\t\t\t\t\t\t</CollapsibleContent>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t</Collapsible>\n\t\t\t\t\t</SidebarMenuItem>\n\t\t\t\t{/each}\n\t\t\t</SidebarMenu>\n\t\t</SidebarGroup>\n\t</SidebarContent>\n\t<SidebarRail />\n</Sidebar>\n\n<style>\n\t/* Square docs logo */\n\t.docsLogo {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-lg);\n\t\tbackground-color: var(--sidebar-primary);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.docsLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* Name above the version */\n\t.docsTitle {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: calc(var(--spacing-xs) / 2);\n\t\tline-height: 1;\n\t}\n\n\t.docsTitle strong {\n\t\tfont-weight: 500;\n\t}\n\n\t/* Plus while the section is closed, minus while it is open, both at the end */\n\t:global(.sidebarMenuButton.sectionToggle .sectionPlus),\n\t:global(.sidebarMenuButton.sectionToggle .sectionMinus) {\n\t\tmargin-left: auto;\n\t}\n\n\t:global(.sidebarMenuButton.sectionToggle .sectionMinus),\n\t:global(.sidebarMenuButton.sectionToggle[aria-expanded=\"true\"] .sectionPlus) {\n\t\tdisplay: none;\n\t}\n\n\t:global(.sidebarMenuButton.sectionToggle[aria-expanded=\"true\"] .sectionMinus) {\n\t\tdisplay: block;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-05/search-form.svelte",
            "target": "src/routes/(blocks)/sidebar-05/search-form.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarInput } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Label } from \"#lib/components/ui/label/index.js\";\n\timport { SearchIcon } from \"@lucide/svelte\";\n\tconst { ...props }: CompProps<\"form\"> = $props();\n</script>\n\n<!-- Docs search field with a leading icon. -->\n<form class=\"searchForm\" {...props}>\n\t<SidebarGroup style=\"padding-block: 0\">\n\t\t<SidebarGroupContent style=\"position: relative\">\n\t\t\t<Label for=\"search\" class=\"srOnly\">Search</Label>\n\t\t\t<SidebarInput id=\"search\" placeholder=\"Search the docs...\" class=\"searchInput\" />\n\t\t\t<SearchIcon class=\"searchIcon\" />\n\t\t</SidebarGroupContent>\n\t</SidebarGroup>\n</form>\n\n<style>\n\t/* Label kept for screen readers only */\n\t.searchForm :global(.srOnly) {\n\t\tposition: absolute;\n\t\tclip-path: inset(50%);\n\t\tmargin: -1px;\n\t\tpadding: 0;\n\t\twidth: 1px;\n\t\theight: 1px;\n\t\toverflow: hidden;\n\t\twhite-space: nowrap;\n\t}\n\n\t/* Room on the start edge for the icon */\n\t.searchForm :global(.input.searchInput) {\n\t\tpadding-left: var(--spacing-xl);\n\t}\n\n\t/* Muted icon over the start of the input */\n\t.searchForm :global(.searchIcon) {\n\t\tposition: absolute;\n\t\ttop: 50%;\n\t\tleft: var(--spacing-sm);\n\t\ttransform: translateY(-50%);\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tpointer-events: none;\n\t\tcolor: color-mix(in oklab, var(--foreground) 50%, transparent);\n\t\tuser-select: none;\n\t}\n</style>\n"
        }
    ],
    "itemDependencies": [
        "/r/sidebar.json",
        "/r/breadcrumb.json",
        "/r/separator.json",
        "/r/collapsible.json",
        "/r/label.json"
    ],
    "devDependencies": [
        "@lucide/svelte"
    ],
    "description": "A sidebar with collapsible submenus."
