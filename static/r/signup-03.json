            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { GalleryVerticalEndIcon } from \"@lucide/svelte\";\n\timport SignupForm from \"./signup-form.svelte\";\n</script>\n\n<PageMeta title=\"Signup 03 example\" description=\"A sign up card on a muted background.\" />\n\n<!-- Brand above a centered sign up card. -->\n<div class=\"loginPage not-typeset\">\n\t<div class=\"loginPageInner\">\n\t\t<a href=\"/\" class=\"brand\">\n\t\t\t<span class=\"brandLogo\"><GalleryVerticalEndIcon /></span>\n\t\t\tAcme Inc.\n\t\t</a>\n\t\t<SignupForm />\n\t</div>\n</div>\n\n<style>\n\t/* Full-height muted page that centers the form */\n\t.loginPage {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tgap: var(--spacing-xl);\n\t\tbackground-color: var(--muted);\n\t\tpadding: var(--spacing-xl);\n\t\tmin-height: 100svh;\n\t}\n\n\t.loginPageInner {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-xl);\n\t\twidth: 100%;\n\t\tmax-width: 24rem; /* 384px */\n\t}\n\n\t/* Brand link centered above the card */\n\t.brand {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\talign-self: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: inherit;\n\t\tfont-weight: 500;\n\t\ttext-decoration: none;\n\t}\n\n\t.brandLogo {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-md);\n\t\tbackground-color: var(--primary);\n\t\twidth: var(--control-height-xs);\n\t\theight: var(--control-height-xs);\n\t\tcolor: var(--primary-foreground);\n\t}\n\n\t.brandLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.loginPage {\n\t\t\tpadding: calc(var(--spacing-xl) + var(--spacing-lg)); /* 40px */\n\t\t}\n\t}\n</style>\n"
