            "content": "<script lang=\"ts\">\n\timport type { Props } from \"./index.js\";\n\tconst { ratio = 1, rounded, children, class: className, ...props }: Props = $props();\n</script>\n\n<!-- Fills the width and sets the height from the ratio; images and videos inside cover it. -->\n<div class={[\"aspectRatio not-typeset\", className]} data-rounded={rounded} style:aspect-ratio={ratio} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base box */\n\t.aspectRatio {\n\t\tposition: relative;\n\t\twidth: 100%;\n\t}\n\n\t/* Media fills the box and crops to the ratio */\n\t.aspectRatio > :global(img),\n\t.aspectRatio > :global(video),\n\t.aspectRatio > :global(iframe) {\n\t\tdisplay: block;\n\t\tborder: 0;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tobject-fit: cover;\n\t}\n\n\t/* =============== Rounded =============== */\n\n\t/* Rounds the box and clips the media to its corners */\n\t.aspectRatio[data-rounded] {\n\t\toverflow: hidden;\n\t}\n\n\t.aspectRatio[data-rounded=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t}\n\n\t.aspectRatio[data-rounded=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t}\n\n\t.aspectRatio[data-rounded=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t}\n\n\t.aspectRatio[data-rounded=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t}\n\n\t.aspectRatio[data-rounded=\"xl\"] {\n\t\tborder-radius: var(--radius-xl);\n\t}\n\n\t.aspectRatio[data-rounded=\"2xl\"] {\n\t\tborder-radius: var(--radius-2xl);\n\t}\n\n\t.aspectRatio[data-rounded=\"3xl\"] {\n\t\tborder-radius: var(--radius-3xl);\n\t}\n\n\t.aspectRatio[data-rounded=\"4xl\"] {\n\t\tborder-radius: var(--radius-4xl);\n\t}\n\n\t/* A true pill; tall content can clip at the corners, so use 3xl or 4xl to stay safe */\n\t.aspectRatio[data-rounded=\"pill\"] {\n\t\tborder-radius: var(--radius-pill);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/aspect-ratio/index.ts",
            "content": "export { default as AspectRatio } from \"./_.svelte\";\n\n/** Box that keeps a width to height ratio as it resizes */\nexport interface Props extends CompPropsWithChild<\"div\"> {\n\t/** Width divided by height, such as `16 / 9`; defaults to `1` */\n\tratio?: number;\n\t/** Corner radius; square when omitted. Clips the content to the corners. `pill` is a true pill that can clip the content, so use `3xl` or `4xl` to stay round */\n\trounded?: UiRounded;\n\t/** Classes merged onto the box */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\nexport type AspectRatioProps = Props;\n"
        }
    ],
    "description": "A box that keeps a width to height ratio as it resizes, with media that covers it."
