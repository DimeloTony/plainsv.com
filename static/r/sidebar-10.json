            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbPage } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n\timport NavActions from \"./nav-actions.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 10 example\" description=\"A sidebar in a popover.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Page title on the start, page actions on the end. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<div class=\"pageHeaderStart\">\n\t\t\t\t<SidebarTrigger />\n\t\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t\t<Breadcrumb>\n\t\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage class=\"pageTitle\">Project Management & Task Tracking</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t\t</BreadcrumbList>\n\t\t\t\t</Breadcrumb>\n\t\t\t</div>\n\t\t\t<div class=\"pageHeaderEnd\">\n\t\t\t\t<NavActions />\n\t\t\t</div>\n\t\t</header>\n\n\t\t<!-- Placeholder document. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"block blockShort\"></div>\n\t\t\t<div class=\"block blockTall\"></div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\theight: 3.5rem; /* 56px */\n\t}\n\n\t.pageHeaderStart {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tpadding-inline: var(--spacing-md);\n\t\tmin-width: 0;\n\t}\n\n\t/* The page title stays on one line */\n\t.pageHeaderStart :global(.pageTitle) {\n\t\tdisplay: -webkit-box;\n\t\t-webkit-box-orient: vertical;\n\t\t-webkit-line-clamp: 1;\n\t\tline-clamp: 1;\n\t\toverflow: hidden;\n\t}\n\n\t.pageHeaderEnd {\n\t\tmargin-left: auto;\n\t\tpadding-inline: var(--spacing-md);\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: 2.5rem var(--spacing-lg); /* 40px */\n\t}\n\n\t/* Placeholder blocks in a centered column */\n\t.block {\n\t\tmargin-inline: auto;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\twidth: 100%;\n\t\tmax-width: 48rem; /* 768px */\n\t}\n\n\t.blockShort {\n\t\theight: 6rem; /* 96px */\n\t}\n\n\t.blockTall {\n\t\tflex: 1;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-10/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarHeader, SidebarRail, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { TerminalIcon, AudioLinesIcon, SearchIcon, SparklesIcon, HouseIcon, InboxIcon, CalendarIcon, Settings2Icon, BlocksIcon, Trash2Icon, MessageCircleQuestionIcon } from \"@lucide/svelte\";\n\timport TeamSwitcher from \"./team-switcher.svelte\";\n\timport NavMain from \"./nav-main.svelte\";\n\timport NavFavorites from \"./nav-favorites.svelte\";\n\timport NavWorkspaces from \"./nav-workspaces.svelte\";\n\timport NavSecondary from \"./nav-secondary.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample teams, links, favorites, and workspaces.\n\tconst data = {\n\t\tteams: [\n\t\t\t{ name: \"Acme Inc\", logo: TerminalIcon, plan: \"Enterprise\" },\n\t\t\t{ name: \"Acme Corp.\", logo: AudioLinesIcon, plan: \"Startup\" },\n\t\t\t{ name: \"Evil Corp.\", logo: TerminalIcon, plan: \"Free\" },\n\t\t],\n\t\tnavMain: [\n\t\t\t{ title: \"Search\", url: \"#\", icon: SearchIcon },\n\t\t\t{ title: \"Ask AI\", url: \"#\", icon: SparklesIcon },\n\t\t\t{ title: \"Home\", url: \"#\", icon: HouseIcon, isActive: true },\n\t\t\t{ title: \"Inbox\", url: \"#\", icon: InboxIcon },\n\t\t],\n\t\tnavSecondary: [\n\t\t\t{ title: \"Calendar\", url: \"#\", icon: CalendarIcon },\n\t\t\t{ title: \"Settings\", url: \"#\", icon: Settings2Icon },\n\t\t\t{ title: \"Templates\", url: \"#\", icon: BlocksIcon },\n\t\t\t{ title: \"Trash\", url: \"#\", icon: Trash2Icon },\n\t\t\t{ title: \"Help\", url: \"#\", icon: MessageCircleQuestionIcon },\n\t\t],\n\t\tfavorites: [\n\t\t\t{ name: \"Project Management & Task Tracking\", url: \"#\", emoji: \"📊\" },\n\t\t\t{ name: \"Family Recipe Collection & Meal Planning\", url: \"#\", emoji: \"🍳\" },\n\t\t\t{ name: \"Fitness Tracker & Workout Routines\", url: \"#\", emoji: \"💪\" },\n\t\t\t{ name: \"Book Notes & Reading List\", url: \"#\", emoji: \"📚\" },\n\t\t\t{ name: \"Sustainable Gardening Tips & Plant Care\", url: \"#\", emoji: \"🌱\" },\n\t\t\t{ name: \"Language Learning Progress & Resources\", url: \"#\", emoji: \"🗣️\" },\n\t\t\t{ name: \"Home Renovation Ideas & Budget Tracker\", url: \"#\", emoji: \"🏠\" },\n\t\t\t{ name: \"Personal Finance & Investment Portfolio\", url: \"#\", emoji: \"💰\" },\n\t\t\t{ name: \"Movie & TV Show Watchlist with Reviews\", url: \"#\", emoji: \"🎬\" },\n\t\t\t{ name: \"Daily Habit Tracker & Goal Setting\", url: \"#\", emoji: \"✅\" },\n\t\t],\n\t\tworkspaces: [\n\t\t\t{\n\t\t\t\tname: \"Personal Life Management\",\n\t\t\t\temoji: \"🏠\",\n\t\t\t\tpages: [\n\t\t\t\t\t{ name: \"Daily Journal & Reflection\", url: \"#\", emoji: \"📔\" },\n\t\t\t\t\t{ name: \"Health & Wellness Tracker\", url: \"#\", emoji: \"🍏\" },\n\t\t\t\t\t{ name: \"Personal Growth & Learning Goals\", url: \"#\", emoji: \"🌟\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tname: \"Professional Development\",\n\t\t\t\temoji: \"💼\",\n\t\t\t\tpages: [\n\t\t\t\t\t{ name: \"Career Objectives & Milestones\", url: \"#\", emoji: \"🎯\" },\n\t\t\t\t\t{ name: \"Skill Acquisition & Training Log\", url: \"#\", emoji: \"🧠\" },\n\t\t\t\t\t{ name: \"Networking Contacts & Events\", url: \"#\", emoji: \"🤝\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tname: \"Creative Projects\",\n\t\t\t\temoji: \"🎨\",\n\t\t\t\tpages: [\n\t\t\t\t\t{ name: \"Writing Ideas & Story Outlines\", url: \"#\", emoji: \"✍️\" },\n\t\t\t\t\t{ name: \"Art & Design Portfolio\", url: \"#\", emoji: \"🖼️\" },\n\t\t\t\t\t{ name: \"Music Composition & Practice Log\", url: \"#\", emoji: \"🎵\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tname: \"Home Management\",\n\t\t\t\temoji: \"🏡\",\n\t\t\t\tpages: [\n\t\t\t\t\t{ name: \"Household Budget & Expense Tracking\", url: \"#\", emoji: \"💰\" },\n\t\t\t\t\t{ name: \"Home Maintenance Schedule & Tasks\", url: \"#\", emoji: \"🔧\" },\n\t\t\t\t\t{ name: \"Family Calendar & Event Planning\", url: \"#\", emoji: \"📅\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tname: \"Travel & Adventure\",\n\t\t\t\temoji: \"🧳\",\n\t\t\t\tpages: [\n\t\t\t\t\t{ name: \"Trip Planning & Itineraries\", url: \"#\", emoji: \"🗺️\" },\n\t\t\t\t\t{ name: \"Travel Bucket List & Inspiration\", url: \"#\", emoji: \"🌎\" },\n\t\t\t\t\t{ name: \"Travel Journal & Photo Gallery\", url: \"#\", emoji: \"📸\" },\n\t\t\t\t],\n\t\t\t},\n\t\t],\n\t};\n</script>\n\n<Sidebar class=\"borderlessSidebar\" {...props}>\n\t<!-- Team switcher and the main links. -->\n\t<SidebarHeader>\n\t\t<TeamSwitcher teams={data.teams} />\n\t\t<NavMain items={data.navMain} />\n\t</SidebarHeader>\n\n\t<!-- Favorites, workspaces, and secondary links pushed to the bottom. -->\n\t<SidebarContent>\n\t\t<NavFavorites favorites={data.favorites} />\n\t\t<NavWorkspaces workspaces={data.workspaces} />\n\t\t<NavSecondary items={data.navSecondary} style=\"margin-top: auto\" />\n\t</SidebarContent>\n\t<SidebarRail />\n</Sidebar>\n\n<style>\n\t/* No border between the sidebar and the page */\n\t:global(.sidebar.sidebarDesktop:has(.borderlessSidebar) .sidebarContainer) {\n\t\tborder-right: none;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/nav-actions.svelte",
            "target": "src/routes/(blocks)/sidebar-10/nav-actions.svelte",
            "content": "<script lang=\"ts\">\n\timport { Popover, PopoverTrigger, PopoverContent } from \"#lib/components/ui/popover/index.js\";\n\timport { Sidebar, SidebarContent, SidebarGroup, SidebarGroupContent, SidebarMenu, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Button } from \"#lib/components/ui/button/index.js\";\n\timport { Settings2Icon, FileTextIcon, LinkIcon, CopyIcon, CornerUpRightIcon, Trash2Icon, CornerUpLeftIcon, ChartLineIcon, GalleryVerticalEndIcon, TrashIcon, BellIcon, ArrowUpIcon, ArrowDownIcon, StarIcon, EllipsisIcon } from \"@lucide/svelte\";\n\t// Page actions in groups, divided by borders.\n\tconst groups = [\n\t\t[\n\t\t\t{ label: \"Customize Page\", icon: Settings2Icon },\n\t\t\t{ label: \"Turn into wiki\", icon: FileTextIcon },\n\t\t],\n\t\t[\n\t\t\t{ label: \"Copy Link\", icon: LinkIcon },\n\t\t\t{ label: \"Duplicate\", icon: CopyIcon },\n\t\t\t{ label: \"Move to\", icon: CornerUpRightIcon },\n\t\t\t{ label: \"Move to Trash\", icon: Trash2Icon },\n\t\t],\n\t\t[\n\t\t\t{ label: \"Undo\", icon: CornerUpLeftIcon },\n\t\t\t{ label: \"View analytics\", icon: ChartLineIcon },\n\t\t\t{ label: \"Version History\", icon: GalleryVerticalEndIcon },\n\t\t\t{ label: \"Show delete pages\", icon: TrashIcon },\n\t\t\t{ label: \"Notifications\", icon: BellIcon },\n\t\t],\n\t\t[\n\t\t\t{ label: \"Import\", icon: ArrowUpIcon },\n\t\t\t{ label: \"Export\", icon: ArrowDownIcon },\n\t\t],\n\t];\n\tlet isOpen = $state(false);\n\n\t// The menu opens once the page loads, to show it off in this example.\n\t$effect(() => {\n\t\tisOpen = true;\n\t});\n</script>\n\n<div class=\"navActions\">\n\t<span class=\"editedAt\">Edit Oct 08</span>\n\t<Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Add to favorites\"><StarIcon /></Button>\n\n\t<!-- Page actions in a static sidebar inside a popover. -->\n\t<Popover bind:open={isOpen} align=\"end\">\n\t\t<PopoverTrigger>\n\t\t\t{#snippet trigger({ props })}\n\t\t\t\t<Button variant=\"ghost\" size=\"icon-sm\" class=\"actionsButton\" aria-label=\"Page actions\" {...props}><EllipsisIcon /></Button>\n\t\t\t{/snippet}\n\t\t</PopoverTrigger>\n\t\t<PopoverContent rounded=\"lg\" style=\"width: 14rem; padding: 0; overflow: hidden\">\n\t\t\t<Sidebar collapsible=\"none\" class=\"actionsSidebar\">\n\t\t\t\t<SidebarContent>\n\t\t\t\t\t{#each groups as group, index (index)}\n\t\t\t\t\t\t<SidebarGroup class=\"actionsGroup\">\n\t\t\t\t\t\t\t<SidebarGroupContent>\n\t\t\t\t\t\t\t\t<SidebarMenu>\n\t\t\t\t\t\t\t\t\t{#each group as item (item.label)}\n\t\t\t\t\t\t\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t\t\t\t\t\t\t<SidebarMenuButton>\n\t\t\t\t\t\t\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t\t\t\t\t\t\t<span>{item.label}</span>\n\t\t\t\t\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t\t\t\t\t</SidebarMenuItem>\n\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t</SidebarMenu>\n\t\t\t\t\t\t\t</SidebarGroupContent>\n\t\t\t\t\t\t</SidebarGroup>\n\t\t\t\t\t{/each}\n\t\t\t\t</SidebarContent>\n\t\t\t</Sidebar>\n\t\t</PopoverContent>\n\t</Popover>\n</div>\n\n<style>\n\t.navActions {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tfont-size: var(--text-sm);\n\t}\n\n\t/* The edit date only shows on wider screens */\n\t.editedAt {\n\t\tdisplay: none;\n\t\tcolor: var(--muted-foreground);\n\t\tfont-weight: 500;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.editedAt {\n\t\t\tdisplay: inline-block;\n\t\t}\n\t}\n\n\t.navActions :global(.button.actionsButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--accent);\n\t}\n\n\t/* The sidebar fills the popover on a transparent background */\n\t:global(.popoverContent .sidebar.sidebarStatic.actionsSidebar) {\n\t\tbackground-color: transparent;\n\t\twidth: 100%;\n\t}\n\n\t/* Groups divided by borders */\n\t:global(.actionsSidebar .sidebarGroup.actionsGroup) {\n\t\tborder-bottom: 1px solid var(--border);\n\t}\n\n\t:global(.actionsSidebar .sidebarGroup.actionsGroup:last-child) {\n\t\tborder-bottom: none;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/nav-favorites.svelte",
            "target": "src/routes/(blocks)/sidebar-10/nav-favorites.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { EllipsisIcon, StarOffIcon, LinkIcon, ArrowUpRightIcon, Trash2Icon } from \"@lucide/svelte\";\n\tconst { favorites }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Favorite pages with a menu of actions on each; hidden while collapsed to icons */\n\tinterface Props {\n\t\t/** Pages with an emoji */\n\t\tfavorites: { name: string; url: string; emoji: string }[];\n\t}\n</script>\n\n<SidebarGroup class=\"favoritesGroup\">\n\t<SidebarGroupLabel>Favorites</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each favorites as item (item.name)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton href={item.url} title={item.name}>\n\t\t\t\t\t<span>{item.emoji}</span>\n\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t<!-- Actions menu; opens below on mobile and beside the sidebar on desktop. -->\n\t\t\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align={sidebar.isMobile ? \"end\" : \"start\"}>\n\t\t\t\t\t<DropdownMenuTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"favoriteAction\" aria-label=\"More for {item.name}\" {...props}><EllipsisIcon /></SidebarMenuAction>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</DropdownMenuTrigger>\n\t\t\t\t\t<DropdownMenuContent rounded=\"lg\" style=\"min-width: 14rem\">\n\t\t\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t\t\t<DropdownMenuItem><StarOffIcon /> Remove from Favorites</DropdownMenuItem>\n\t\t\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t\t\t<DropdownMenuItem><LinkIcon /> Copy Link</DropdownMenuItem>\n\t\t\t\t\t\t\t<DropdownMenuItem><ArrowUpRightIcon /> Open in New Tab</DropdownMenuItem>\n\t\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t\t<DropdownMenuItem><Trash2Icon /> Delete</DropdownMenuItem>\n\t\t\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t\t</DropdownMenuContent>\n\t\t\t\t</DropdownMenu>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\n\t\t<!-- Muted link to the rest of the favorites. -->\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton class=\"moreButton\">\n\t\t\t\t<EllipsisIcon />\n\t\t\t\t<span>More</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* Collapsed to icons, the favorites hide */\n\t:global(.sidebar[data-collapsible=\"icon\"] .sidebarGroup.favoritesGroup) {\n\t\tdisplay: none;\n\t}\n\n\t/* The action stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuAction.favoriteAction[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.moreButton) {\n\t\tcolor: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/nav-main.svelte",
            "target": "src/routes/(blocks)/sidebar-10/nav-main.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\tconst { items }: Props = $props();\n\t/** Main links under the team switcher */\n\tinterface Props {\n\t\t/** Links with their icons, one marked as the current page */\n\t\titems: { title: string; url: string; icon: Component; isActive?: boolean }[];\n\t}\n</script>\n\n<SidebarMenu>\n\t{#each items as item (item.title)}\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton href={item.url} isActive={item.isActive}>\n\t\t\t\t<item.icon />\n\t\t\t\t<span>{item.title}</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t{/each}\n</SidebarMenu>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/nav-secondary.svelte",
            "target": "src/routes/(blocks)/sidebar-10/nav-secondary.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarMenu, SidebarMenuBadge, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\tconst { items, ...props }: Props = $props();\n\t/** Secondary links, such as settings and help, with optional counts */\n\tinterface Props extends CompProps<\"div\"> {\n\t\t/** Links with their icons and an optional badge */\n\t\titems: { title: string; url: string; icon: Component; badge?: string }[];\n\t}\n</script>\n\n<SidebarGroup {...props}>\n\t<SidebarGroupContent>\n\t\t<SidebarMenu>\n\t\t\t{#each items as item (item.title)}\n\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t<SidebarMenuButton href={item.url}>\n\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t{#if item.badge}\n\t\t\t\t\t\t<SidebarMenuBadge>{item.badge}</SidebarMenuBadge>\n\t\t\t\t\t{/if}\n\t\t\t\t</SidebarMenuItem>\n\t\t\t{/each}\n\t\t</SidebarMenu>\n\t</SidebarGroupContent>\n</SidebarGroup>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-10/nav-workspaces.svelte",
            "target": "src/routes/(blocks)/sidebar-10/nav-workspaces.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon, PlusIcon, EllipsisIcon } from \"@lucide/svelte\";\n\tconst { workspaces }: Props = $props();\n\t/** Workspaces that expand into their pages */\n\tinterface Props {\n\t\t/** Workspaces with an emoji and their pages */\n\t\tworkspaces: { name: string; emoji: string; pages: { name: string; url: string; emoji: string }[] }[];\n\t}\n</script>\n\n<SidebarGroup>\n\t<SidebarGroupLabel>Workspaces</SidebarGroupLabel>\n\t<SidebarGroupContent>\n\t\t<SidebarMenu>\n\t\t\t{#each workspaces as workspace (workspace.name)}\n\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t<Collapsible>\n\t\t\t\t\t\t<SidebarMenuButton href=\"#\">\n\t\t\t\t\t\t\t<span>{workspace.emoji}</span>\n\t\t\t\t\t\t\t<span>{workspace.name}</span>\n\t\t\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t\t\t<!-- On hover, a chevron over the emoji expands the pages, and a plus adds one. -->\n\t\t\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"workspaceToggle\" aria-label=\"Toggle {workspace.name}\" {...props}><ChevronRightIcon /></SidebarMenuAction>\n\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t\t\t<SidebarMenuAction showOnHover aria-label=\"Add a page to {workspace.name}\"><PlusIcon /></SidebarMenuAction>\n\t\t\t\t\t\t<CollapsibleContent>\n\t\t\t\t\t\t\t<SidebarMenuSub>\n\t\t\t\t\t\t\t\t{#each workspace.pages as page (page.name)}\n\t\t\t\t\t\t\t\t\t<SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t\t<SidebarMenuSubButton href={page.url}>\n\t\t\t\t\t\t\t\t\t\t\t<span>{page.emoji}</span>\n\t\t\t\t\t\t\t\t\t\t\t<span>{page.name}</span>\n\t\t\t\t\t\t\t\t\t\t</SidebarMenuSubButton>\n\t\t\t\t\t\t\t\t\t</SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t</SidebarMenuSub>\n\t\t\t\t\t\t</CollapsibleContent>\n\t\t\t\t\t</Collapsible>\n\t\t\t\t</SidebarMenuItem>\n\t\t\t{/each}\n\n\t\t\t<!-- Muted link to the rest of the workspaces. -->\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton class=\"moreButton\">\n\t\t\t\t\t<EllipsisIcon />\n\t\t\t\t\t<span>More</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t</SidebarGroupContent>\n</SidebarGroup>\n\n<style>\n\t/* The toggle covers the emoji on the start edge, and points down while open */\n\t:global(.sidebar .sidebarMenuAction.workspaceToggle) {\n\t\tright: auto;\n\t\tleft: var(--spacing-sm);\n\t\ttransition-property: color, background-color, box-shadow, opacity, transform;\n\t\tbackground-color: var(--sidebar-accent);\n\t\tcolor: var(--sidebar-accent-foreground);\n\t}\n\n\t:global(.sidebar .sidebarMenuAction.workspaceToggle[aria-expanded=\"true\"]) {\n\t\ttransform: rotate(90deg);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.moreButton) {\n\t\tcolor: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent);\n\t}\n</style>\n"
        },
