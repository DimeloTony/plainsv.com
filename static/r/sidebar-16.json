            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset } from \"#lib/components/ui/sidebar/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n\timport SiteHeader from \"./site-header.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 16 example\" description=\"A sidebar with a sticky site header.\" />\n\n<!-- The site header spans the top; the sidebar and the page sit in a row below it. -->\n<SidebarProvider style=\"flex-direction: column\">\n\t<SiteHeader />\n\t<div class=\"pageRow\">\n\t\t<AppSidebar />\n\t\t<SidebarInset>\n\t\t\t<!-- Placeholder content. -->\n\t\t\t<div class=\"pageBody\">\n\t\t\t\t<div class=\"tiles\">\n\t\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"tile tileLarge\"></div>\n\t\t\t</div>\n\t\t</SidebarInset>\n\t</div>\n</SidebarProvider>\n\n<style>\n\t.pageRow {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* Placeholder content blocks */\n\t.tiles {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.tile {\n\t\tflex: 1 1 12rem;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 16 / 9;\n\t}\n\n\t.tileLarge {\n\t\tflex: 1;\n\t\taspect-ratio: auto;\n\t\tmin-height: 100svh;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.tileLarge {\n\t\t\tmin-height: min-content;\n\t\t}\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-16/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarFooter, SidebarHeader, SidebarMenu, SidebarMenuButton, SidebarMenuItem, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { TerminalIcon, SquareTerminalIcon, BotIcon, BookOpenIcon, Settings2Icon, LifeBuoyIcon, SendIcon, FrameIcon, ChartPieIcon, MapIcon } from \"@lucide/svelte\";\n\timport NavMain from \"./nav-main.svelte\";\n\timport NavProjects from \"./nav-projects.svelte\";\n\timport NavSecondary from \"./nav-secondary.svelte\";\n\timport NavUser from \"./nav-user.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample navigation, projects, secondary links, and user.\n\tconst data = {\n\t\tuser: { name: \"shadcn\", email: \"m@example.com\", initials: \"CN\" },\n\t\tnavMain: [\n\t\t\t{\n\t\t\t\ttitle: \"Playground\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: SquareTerminalIcon,\n\t\t\t\tisActive: true,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"History\", url: \"#\" },\n\t\t\t\t\t{ title: \"Starred\", url: \"#\" },\n\t\t\t\t\t{ title: \"Settings\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Models\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: BotIcon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Genesis\", url: \"#\" },\n\t\t\t\t\t{ title: \"Explorer\", url: \"#\" },\n\t\t\t\t\t{ title: \"Quantum\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Documentation\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: BookOpenIcon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Introduction\", url: \"#\" },\n\t\t\t\t\t{ title: \"Get Started\", url: \"#\" },\n\t\t\t\t\t{ title: \"Tutorials\", url: \"#\" },\n\t\t\t\t\t{ title: \"Changelog\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Settings\",\n\t\t\t\turl: \"#\",\n\t\t\t\ticon: Settings2Icon,\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"General\", url: \"#\" },\n\t\t\t\t\t{ title: \"Team\", url: \"#\" },\n\t\t\t\t\t{ title: \"Billing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Limits\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t],\n\t\tnavSecondary: [\n\t\t\t{ title: \"Support\", url: \"#\", icon: LifeBuoyIcon },\n\t\t\t{ title: \"Feedback\", url: \"#\", icon: SendIcon },\n\t\t],\n\t\tprojects: [\n\t\t\t{ name: \"Design Engineering\", url: \"#\", icon: FrameIcon },\n\t\t\t{ name: \"Sales & Marketing\", url: \"#\", icon: ChartPieIcon },\n\t\t\t{ name: \"Travel\", url: \"#\", icon: MapIcon },\n\t\t],\n\t};\n</script>\n\n<!-- The fixed panel starts below the sticky site header. -->\n<Sidebar offsetTop=\"3.5rem\" {...props}>\n\t<!-- Company logo and plan. -->\n\t<SidebarHeader>\n\t\t<SidebarMenu>\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton size=\"lg\" href=\"#\">\n\t\t\t\t\t<span class=\"companyLogo\"><TerminalIcon /></span>\n\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t<strong>Acme Inc</strong>\n\t\t\t\t\t\t<span>Enterprise</span>\n\t\t\t\t\t</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t</SidebarHeader>\n\n\t<!-- Platform sections, projects, and secondary links pushed to the bottom. -->\n\t<SidebarContent>\n\t\t<NavMain items={data.navMain} />\n\t\t<NavProjects projects={data.projects} />\n\t\t<NavSecondary items={data.navSecondary} style=\"margin-top: auto\" />\n\t</SidebarContent>\n\n\t<!-- Signed-in user with an account menu. -->\n\t<SidebarFooter>\n\t\t<NavUser user={data.user} />\n\t</SidebarFooter>\n</Sidebar>\n\n<style>\n\t/* Square company logo */\n\t.companyLogo {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-lg);\n\t\tbackground-color: var(--sidebar-primary);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.companyLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* Name above the plan, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/nav-main.svelte",
            "target": "src/routes/(blocks)/sidebar-16/nav-main.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon } from \"@lucide/svelte\";\n\tconst { items }: Props = $props();\n\t/** Platform links, each with an action that expands its pages */\n\tinterface Props {\n\t\t/** Sections with an icon, whether they start open, and their pages */\n\t\titems: { title: string; url: string; icon: Component; isActive?: boolean; items?: { title: string; url: string }[] }[];\n\t}\n</script>\n\n<SidebarGroup>\n\t<SidebarGroupLabel>Platform</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each items as item (item.title)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<Collapsible defaultOpen={item.isActive}>\n\t\t\t\t\t<!-- The section is a link; the action beside it expands its pages. -->\n\t\t\t\t\t<SidebarMenuButton href={item.url} tooltip={item.title}>\n\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t{#if item.items?.length}\n\t\t\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t\t<SidebarMenuAction class=\"sectionToggle\" aria-label=\"Toggle {item.title}\" {...props}><ChevronRightIcon /></SidebarMenuAction>\n\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t\t\t<CollapsibleContent>\n\t\t\t\t\t\t\t<SidebarMenuSub>\n\t\t\t\t\t\t\t\t{#each item.items as page (page.title)}\n\t\t\t\t\t\t\t\t\t<SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t\t<SidebarMenuSubButton href={page.url}><span>{page.title}</span></SidebarMenuSubButton>\n\t\t\t\t\t\t\t\t\t</SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t</SidebarMenuSub>\n\t\t\t\t\t\t</CollapsibleContent>\n\t\t\t\t\t{/if}\n\t\t\t\t</Collapsible>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* The chevron points down while the pages are shown */\n\t:global(.sidebar .sidebarMenuAction.sectionToggle) {\n\t\ttransition: transform 200ms ease;\n\t}\n\n\t:global(.sidebar .sidebarMenuAction.sectionToggle[aria-expanded=\"true\"]) {\n\t\ttransform: rotate(90deg);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/nav-projects.svelte",
            "target": "src/routes/(blocks)/sidebar-16/nav-projects.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { EllipsisIcon, FolderIcon, ShareIcon, Trash2Icon } from \"@lucide/svelte\";\n\tconst { projects }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Project links with a menu of actions on each; hidden while collapsed to icons */\n\tinterface Props {\n\t\t/** Projects with their icons */\n\t\tprojects: { name: string; url: string; icon: Component }[];\n\t}\n</script>\n\n<SidebarGroup class=\"projectsGroup\">\n\t<SidebarGroupLabel>Projects</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each projects as item (item.name)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton href={item.url}>\n\t\t\t\t\t<item.icon />\n\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t<!-- Actions menu; opens below on mobile and beside the sidebar on desktop. -->\n\t\t\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align={sidebar.isMobile ? \"end\" : \"start\"}>\n\t\t\t\t\t<DropdownMenuTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"projectAction\" aria-label=\"More for {item.name}\" {...props}><EllipsisIcon /></SidebarMenuAction>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</DropdownMenuTrigger>\n\t\t\t\t\t<DropdownMenuContent style=\"min-width: 12rem\">\n\t\t\t\t\t\t<DropdownMenuItem><FolderIcon /> View Project</DropdownMenuItem>\n\t\t\t\t\t\t<DropdownMenuItem><ShareIcon /> Share Project</DropdownMenuItem>\n\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t<DropdownMenuItem><Trash2Icon /> Delete Project</DropdownMenuItem>\n\t\t\t\t\t</DropdownMenuContent>\n\t\t\t\t</DropdownMenu>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\n\t\t<!-- Link to the rest of the projects. -->\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton>\n\t\t\t\t<EllipsisIcon />\n\t\t\t\t<span>More</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* Collapsed to icons, the projects hide */\n\t:global(.sidebar[data-collapsible=\"icon\"] .sidebarGroup.projectsGroup) {\n\t\tdisplay: none;\n\t}\n\n\t/* The action stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuAction.projectAction[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/nav-secondary.svelte",
            "target": "src/routes/(blocks)/sidebar-16/nav-secondary.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarMenu, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\tconst { items, ...props }: Props = $props();\n\t/** Small secondary links, such as support and feedback */\n\tinterface Props extends CompProps<\"div\"> {\n\t\t/** Links with their icons */\n\t\titems: { title: string; url: string; icon: Component }[];\n\t}\n</script>\n\n<SidebarGroup {...props}>\n\t<SidebarGroupContent>\n\t\t<SidebarMenu>\n\t\t\t{#each items as item (item.title)}\n\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t<SidebarMenuButton size=\"sm\" href={item.url}>\n\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t</SidebarMenuItem>\n\t\t\t{/each}\n\t\t</SidebarMenu>\n\t</SidebarGroupContent>\n</SidebarGroup>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/nav-user.svelte",
            "target": "src/routes/(blocks)/sidebar-16/nav-user.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { Avatar, AvatarFallback } from \"#lib/components/ui/avatar/index.js\";\n\timport { ChevronsUpDownIcon, SparklesIcon, BadgeCheckIcon, CreditCardIcon, BellIcon, LogOutIcon } from \"@lucide/svelte\";\n\tconst { user }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Signed-in user shown in the sidebar footer */\n\tinterface Props {\n\t\t/** Name, email, and avatar initials */\n\t\tuser: { name: string; email: string; initials: string };\n\t}\n</script>\n\n<SidebarMenu>\n\t<SidebarMenuItem>\n\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align=\"end\" sideOffset={4}>\n\t\t\t<!-- User button with the avatar, name, and email. -->\n\t\t\t<DropdownMenuTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarMenuButton size=\"lg\" class=\"userButton\" {...props}>\n\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<ChevronsUpDownIcon class=\"userChevron\" />\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t{/snippet}\n\t\t\t</DropdownMenuTrigger>\n\n\t\t\t<!-- Account menu. -->\n\t\t\t<DropdownMenuContent style=\"min-width: 14rem\">\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuLabel>\n\t\t\t\t\t\t<span class=\"userLabel\">\n\t\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</DropdownMenuLabel>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><SparklesIcon /> Upgrade to Pro</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><BadgeCheckIcon /> Account</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><CreditCardIcon /> Billing</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><BellIcon /> Notifications</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuItem><LogOutIcon /> Log out</DropdownMenuItem>\n\t\t\t</DropdownMenuContent>\n\t\t</DropdownMenu>\n\t</SidebarMenuItem>\n</SidebarMenu>\n\n<style>\n\t/* Name above the email, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tfont-size: var(--text-sm);\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n\n\t/* Avatar and text in the menu heading */\n\t.userLabel {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: var(--foreground);\n\t\tfont-weight: 400;\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.userButton .userChevron) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The button stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuButton.userButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t\tcolor: var(--foreground);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-16/search-form.svelte",
            "target": "src/routes/(blocks)/sidebar-16/search-form.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarInput } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Label } from \"#lib/components/ui/label/index.js\";\n\timport { SearchIcon } from \"@lucide/svelte\";\n\tconst { class: className, ...props }: CompProps<\"form\"> = $props();\n</script>\n\n<!-- Search field with a leading icon. -->\n<form class={[\"searchForm\", className]} {...props}>\n\t<div class=\"searchField\">\n\t\t<Label for=\"search\" class=\"srOnly\">Search</Label>\n\t\t<SidebarInput id=\"search\" placeholder=\"Type to search...\" class=\"searchInput\" />\n\t\t<SearchIcon class=\"searchIcon\" />\n\t</div>\n</form>\n\n<style>\n\t.searchField {\n\t\tposition: relative;\n\t}\n\n\t/* Label kept for screen readers only */\n\t.searchForm :global(.srOnly) {\n\t\tposition: absolute;\n\t\tclip-path: inset(50%);\n\t\tmargin: -1px;\n\t\tpadding: 0;\n\t\twidth: 1px;\n\t\theight: 1px;\n\t\toverflow: hidden;\n\t\twhite-space: nowrap;\n\t}\n\n\t/* Room on the start edge for the icon */\n\t.searchForm :global(.input.searchInput) {\n\t\tpadding-left: 1.75rem; /* 28px */\n\t}\n\n\t/* Muted icon over the start of the input */\n\t.searchForm :global(.searchIcon) {\n\t\tposition: absolute;\n\t\ttop: 50%;\n\t\tleft: var(--spacing-sm);\n\t\ttransform: translateY(-50%);\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tpointer-events: none;\n\t\tcolor: color-mix(in oklab, var(--foreground) 50%, transparent);\n\t\tuser-select: none;\n\t}\n</style>\n"
        },
        {
            "type": "file",
