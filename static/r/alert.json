            "type": "file",
            "path": "src/lib/components/ui/alert/_.svelte",
            "content": "<script lang=\"ts\">\n\timport type { Props } from \"./index.js\";\n\tconst { children, variant = \"default\", size = \"lg\", rounded, class: className, ...props }: Props = $props();\n</script>\n\n<!-- Callout with an optional leading icon, a title, a description, and a trailing action. -->\n<div class={[\"alert not-typeset\", className]} role=\"alert\" data-variant={variant} data-size={size} data-rounded={rounded} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base alert; grid lets the icon and action sit beside both the title and description without a wrapper */\n\t.alert {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: minmax(0, 1fr);\n\t\trow-gap: calc(var(--spacing-xs) / 2); /* 2px */\n\t\talign-items: start;\n\t\tbox-sizing: border-box;\n\t\tborder: 1px solid var(--border);\n\t\twidth: 100%;\n\t}\n\n\t/* Adds a leading icon column when the alert starts with an icon */\n\t.alert:has(> :global(svg)) {\n\t\tgrid-template-columns: var(--alert-icon) minmax(0, 1fr);\n\t}\n\n\t/* Adds a trailing column when the alert holds an action */\n\t.alert:has(> :global(.alertAction)) {\n\t\tgrid-template-columns: minmax(0, 1fr) auto;\n\t}\n\n\t.alert:has(> :global(svg)):has(> :global(.alertAction)) {\n\t\tgrid-template-columns: var(--alert-icon) minmax(0, 1fr) auto;\n\t}\n\n\t/* Leading icon sits in the first column, nudged to the title's baseline */\n\t.alert > :global(svg) {\n\t\tgrid-row: 1;\n\t\tgrid-column: 1;\n\t\tflex-shrink: 0;\n\t\ttransform: translateY(0.125rem); /* 2px */\n\t\twidth: var(--alert-icon);\n\t\theight: var(--alert-icon);\n\t\tcolor: currentColor;\n\t}\n\n\t/* Title and description follow the icon column when there is one */\n\t.alert > :global(:not(svg, .alertAction)) {\n\t\tgrid-column: 1;\n\t}\n\n\t.alert:has(> :global(svg)) > :global(:not(svg, .alertAction)) {\n\t\tgrid-column: 2;\n\t}\n\n\t/* The action spans both rows when a description is present */\n\t.alert:has(> :global(.alertDescription)) > :global(.alertAction) {\n\t\tgrid-row: 1 / span 2;\n\t}\n\n\t/* =============== Variants =============== */\n\n\t.alert[data-variant=\"default\"] {\n\t\tbackground-color: var(--card);\n\t\tcolor: var(--card-foreground);\n\t}\n\n\t.alert[data-variant=\"destructive\"] {\n\t\tbackground-color: var(--card);\n\t\tcolor: var(--destructive);\n\t}\n\n\t/* Destructive descriptions use a softer tint of the destructive color */\n\t.alert[data-variant=\"destructive\"] > :global(.alertDescription) {\n\t\tcolor: color-mix(in oklab, var(--destructive) 90%, transparent);\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large — default */\n\t.alert[data-size=\"lg\"] {\n\t\t--alert-icon: 1rem; /* 16px */\n\t\tcolumn-gap: var(--spacing-md);\n\t\tborder-radius: var(--radius-lg);\n\t\tpadding: var(--spacing-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Medium */\n\t.alert[data-size=\"md\"] {\n\t\t--alert-icon: 1rem; /* 16px */\n\t\tcolumn-gap: var(--spacing-sm);\n\t\tborder-radius: var(--radius-md);\n\t\tpadding: var(--spacing-sm) var(--spacing-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Small */\n\t.alert[data-size=\"sm\"] {\n\t\t--alert-icon: 1rem; /* 16px */\n\t\tcolumn-gap: var(--spacing-sm);\n\t\tborder-radius: var(--radius-sm);\n\t\tpadding: var(--spacing-sm);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Extra small */\n\t.alert[data-size=\"xs\"] {\n\t\t--alert-icon: var(--text-xs);\n\t\tcolumn-gap: var(--spacing-sm);\n\t\tborder-radius: var(--radius-xs);\n\t\tpadding: var(--spacing-xs) var(--spacing-sm);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n\n\t/* =============== Rounded =============== */\n\n\t/* Overrides the size radius; must stay after the size rules */\n\t.alert[data-rounded=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t}\n\n\t.alert[data-rounded=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t}\n\n\t.alert[data-rounded=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t}\n\n\t.alert[data-rounded=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t}\n\n\t.alert[data-rounded=\"xl\"] {\n\t\tborder-radius: var(--radius-xl);\n\t}\n\n\t.alert[data-rounded=\"2xl\"] {\n\t\tborder-radius: var(--radius-2xl);\n\t}\n\n\t.alert[data-rounded=\"3xl\"] {\n\t\tborder-radius: var(--radius-3xl);\n\t}\n\n\t.alert[data-rounded=\"4xl\"] {\n\t\tborder-radius: var(--radius-4xl);\n\t}\n\n\t/* A true pill; tall content can clip at the corners, so use 3xl or 4xl to stay safe */\n\t.alert[data-rounded=\"pill\"] {\n\t\tborder-radius: var(--radius-pill);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/alert/action.svelte",
            "content": "<script lang=\"ts\">\n\timport type { ActionProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: ActionProps = $props();\n</script>\n\n<!-- Trailing content placed in the alert's last column. -->\n<div class={[\"alertAction\", className]} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base action */\n\t.alertAction {\n\t\tdisplay: flex;\n\t\tgrid-row: 1;\n\t\tgrid-column: -2;\n\t\talign-items: center;\n\t\talign-self: center;\n\t\tjustify-self: end;\n\t\tgap: var(--spacing-xs);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/alert/description.svelte",
            "content": "<script lang=\"ts\">\n\timport type { DescriptionProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: DescriptionProps = $props();\n</script>\n\n<!-- Muted supporting text; a div so it can hold paragraphs and lists. -->\n<div class={[\"alertDescription\", className]} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base description; inherits the alert's text size */\n\t.alertDescription {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\talign-items: flex-start;\n\t\tgap: var(--spacing-xs);\n\t\tcolor: var(--muted-foreground);\n\t}\n\n\t/* Nested paragraphs drop their margins and read more loosely */\n\t.alertDescription :global(p) {\n\t\tmargin: 0;\n\t\tline-height: 1.625;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/alert/index.ts",
            "content": "export { default as Alert } from \"./_.svelte\";\nexport { default as AlertTitle } from \"./title.svelte\";\nexport { default as AlertDescription } from \"./description.svelte\";\nexport { default as AlertAction } from \"./action.svelte\";\n\n/** Alert root that holds an optional icon, the title, description, and action */\nexport interface Props extends CompPropsWithChild<\"div\"> {\n\t/** Visual style of the alert */\n\tvariant?: \"default\" | \"destructive\";\n\t/** Padding, gap, text, and icon size on the shared scale; defaults to `lg` */\n\tsize?: UiSize;\n\t/** Corner radius; follows `size` when omitted. `pill` is a true pill that can clip the content, so use `3xl` or `4xl` to stay round */\n\trounded?: UiRounded;\n\t/** Classes merged onto the alert */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Alert heading text */\nexport interface TitleProps extends CompPropsWithChild<\"div\"> {\n\t/** Classes merged onto the title */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Supporting text under the title; may hold paragraphs */\nexport interface DescriptionProps extends CompPropsWithChild<\"div\"> {\n\t/** Classes merged onto the description */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Trailing content, such as a button */\nexport interface ActionProps extends CompPropsWithChild<\"div\"> {\n\t/** Classes merged onto the action */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\nexport type AlertProps = Props;\nexport type AlertTitleProps = TitleProps;\nexport type AlertDescriptionProps = DescriptionProps;\nexport type AlertActionProps = ActionProps;\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/alert/title.svelte",
            "content": "<script lang=\"ts\">\n\timport type { TitleProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: TitleProps = $props();\n</script>\n\n<!-- Alert heading text. -->\n<div class={[\"alertTitle\", className]} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base title; clamps to one line */\n\t.alertTitle {\n\t\tdisplay: -webkit-box;\n\t\t-webkit-box-orient: vertical;\n\t\tmin-height: 1rem; /* 16px */\n\t\t-webkit-line-clamp: 1;\n\t\tline-clamp: 1;\n\t\toverflow: hidden;\n\t\tfont-weight: 500;\n\t\tletter-spacing: -0.025em;\n\t}\n</style>\n"
        }
    ],
    "description": "A callout for important messages with an optional icon, a title, a description, and an action."
