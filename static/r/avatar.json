            "content": "<script lang=\"ts\">\n\timport { setCompCtx } from \"./ctx.svelte.js\";\n\timport type { Props } from \"./index.js\";\n\tconst { children, variant = \"default\", size = \"sm\", rounded = \"pill\", class: className, ...props }: Props = $props();\n\tsetCompCtx({ status: \"loading\" });\n</script>\n\n<!-- Avatar frame; the image covers the fallback once it loads. -->\n<span class={[\"avatar not-typeset\", className]} data-variant={variant} data-size={size} data-rounded={rounded} {...props}>\n\t{@render children()}\n</span>\n\n<style>\n\t/* Base avatar; relative so the image can cover the fallback */\n\t.avatar {\n\t\tdisplay: inline-flex;\n\t\tposition: relative;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tbox-sizing: border-box;\n\t\tborder: 1px solid transparent;\n\t\toverflow: hidden;\n\t\tfont-weight: 500;\n\t\tuser-select: none;\n\t}\n\n\t/* =============== Variants =============== */\n\n\t/* Muted backdrop for the fallback */\n\t.avatar[data-variant=\"default\"] {\n\t\tbackground-color: var(--muted);\n\t\tcolor: var(--muted-foreground);\n\t}\n\n\t.avatar[data-variant=\"secondary\"] {\n\t\tbackground-color: var(--secondary);\n\t\tcolor: var(--secondary-foreground);\n\t}\n\n\t/* Bordered frame that stays visible around the image */\n\t.avatar[data-variant=\"outline\"] {\n\t\tborder-color: var(--border);\n\t\tbackground-color: var(--background);\n\t\tcolor: var(--foreground);\n\t}\n\n\t:global(.dark) .avatar[data-variant=\"outline\"] {\n\t\tborder-color: var(--input);\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.avatar[data-size=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t\twidth: var(--control-height-lg);\n\t\theight: var(--control-height-lg);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Medium — default */\n\t.avatar[data-size=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t\twidth: var(--control-height-md);\n\t\theight: var(--control-height-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Small */\n\t.avatar[data-size=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n\n\t/* Extra small */\n\t.avatar[data-size=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t\twidth: var(--control-height-xs);\n\t\theight: var(--control-height-xs);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n\n\t/* Fallback icons scale with the avatar */\n\t.avatar :global(svg) {\n\t\tflex-shrink: 0;\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t.avatar[data-size=\"sm\"] :global(svg) {\n\t\twidth: var(--text-sm);\n\t\theight: var(--text-sm);\n\t}\n\n\t.avatar[data-size=\"xs\"] :global(svg) {\n\t\twidth: var(--text-xs);\n\t\theight: var(--text-xs);\n\t}\n\n\t/* =============== Rounded =============== */\n\n\t/* Overrides the size radius; must stay after the size rules */\n\t.avatar[data-rounded=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t}\n\n\t.avatar[data-rounded=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t}\n\n\t.avatar[data-rounded=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t}\n\n\t.avatar[data-rounded=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t}\n\n\t.avatar[data-rounded=\"xl\"] {\n\t\tborder-radius: var(--radius-xl);\n\t}\n\n\t.avatar[data-rounded=\"2xl\"] {\n\t\tborder-radius: var(--radius-2xl);\n\t}\n\n\t.avatar[data-rounded=\"3xl\"] {\n\t\tborder-radius: var(--radius-3xl);\n\t}\n\n\t.avatar[data-rounded=\"4xl\"] {\n\t\tborder-radius: var(--radius-4xl);\n\t}\n\n\t.avatar[data-rounded=\"pill\"] {\n\t\tborder-radius: var(--radius-pill);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/avatar/ctx.svelte.ts",
            "content": "import { setContext, getContext } from \"svelte\";\n\nconst CONTEXT_ID = \"avatar-context\";\n\nclass UseCompCtx {\n\t/** Load state of the `AvatarImage`; the fallback shows until it is `loaded` */\n\tstatus: \"loading\" | \"loaded\" | \"error\" = $state(\"loading\");\n\n\t// Set default data\n\tconstructor(props: { [key: string]: any }) {\n\t\t// Merge props into this instance (we do not use `Object.assign(this, props)` to ensure only setting props that exists)\n\t\tfor (const [key, data] of Object.entries(props)) {\n\t\t\t// @ts-ignore\n\t\t\tif (this[key] !== undefined) this[key] = data;\n\t\t}\n\t}\n}\n\nexport type CompCtxProps = Pick<InstanceType<typeof UseCompCtx>, \"status\">;\n\nexport const setCompCtx = (props: CompCtxProps) => setContext(CONTEXT_ID, new UseCompCtx(props));\n\nexport const useCompCtx = () => getContext<ReturnType<typeof setCompCtx>>(CONTEXT_ID);\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/avatar/fallback.svelte",
            "content": "<script lang=\"ts\">\n\timport { useCompCtx } from \"./ctx.svelte.js\";\n\timport type { FallbackProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: FallbackProps = $props();\n\tconst ctx = useCompCtx();\n</script>\n\n<!-- Show the fallback until the image loads, and keep it when the image fails. -->\n{#if ctx.status !== \"loaded\"}\n\t<span class={[\"avatarFallback\", className]} {...props}>\n\t\t{@render children()}\n\t</span>\n{/if}\n\n<style>\n\t/* Base fallback; centers initials or an icon in the frame */\n\t.avatarFallback {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/avatar/image.svelte",
            "content": "<script lang=\"ts\">\n\timport { useCompCtx } from \"./ctx.svelte.js\";\n\timport type { Attachment } from \"svelte/attachments\";\n\timport type { ImageProps } from \"./index.js\";\n\tconst { src, alt = \"\", onload, onerror, class: className, ...props }: ImageProps = $props();\n\tconst ctx = useCompCtx();\n\n\t/** Reads the load state on mount, so images that finished before hydration are caught. */\n\tconst syncStatus: Attachment<HTMLImageElement> = (node) => {\n\t\t// If the image is still loading: wait for its load or error event.\n\t\tif (!node.complete) ctx.status = \"loading\";\n\t\t// A complete image without a width failed to load or has no source.\n\t\telse ctx.status = node.naturalWidth > 0 ? \"loaded\" : \"error\";\n\n\t\t// Show the fallback again when the image is removed or remounted for a new source.\n\t\treturn () => (ctx.status = \"loading\");\n\t};\n\n\t/** Marks the image as loaded and forwards the event. */\n\tconst handleLoad = (e: Event) => {\n\t\tctx.status = \"loaded\";\n\t\tonload?.(e);\n\t};\n\n\t/** Marks the image as failed so the fallback stays, and forwards the event. */\n\tconst handleError = (e: Event) => {\n\t\tctx.status = \"error\";\n\t\tonerror?.(e);\n\t};\n</script>\n\n<!-- Remount on a new source so the fallback shows while it loads. -->\n{#key src}\n\t<img class={[\"avatarImage\", className]} {src} {alt} data-status={ctx.status} {@attach syncStatus} onload={handleLoad} onerror={handleError} {...props} />\n{/key}\n\n<style>\n\t/* Base image; covers the frame above the fallback */\n\t.avatarImage {\n\t\tposition: absolute;\n\t\tinset: 0;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tobject-fit: cover;\n\t}\n\n\t/* Hidden rather than removed so lazy images still load */\n\t.avatarImage:not([data-status=\"loaded\"]) {\n\t\tvisibility: hidden;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/avatar/index.ts",
            "content": "export { default as Avatar } from \"./_.svelte\";\nexport { default as AvatarImage } from \"./image.svelte\";\nexport { default as AvatarFallback } from \"./fallback.svelte\";\n\n/** Avatar root that holds the image and its fallback */\nexport interface Props extends CompPropsWithChild<\"span\"> {\n\t/** Visual style of the background and border */\n\tvariant?: \"default\" | \"secondary\" | \"outline\";\n\t/** Size on the shared scale; defaults to `sm`, a 32 pixel avatar like shadcn */\n\tsize?: UiSize;\n\t/** Corner radius; defaults to `pill`, a circle like shadcn */\n\trounded?: UiRounded;\n\t/** Classes merged onto the avatar */\n\tclass?: CompPropsWithChild<\"span\">[\"class\"];\n}\n\n/** User image; stays hidden until it loads */\nexport interface ImageProps extends CompProps<\"img\"> {\n\t/** Classes merged onto the image */\n\tclass?: CompProps<\"img\">[\"class\"];\n}\n\n/** Content shown while the image loads or after it fails, such as initials or an icon */\nexport interface FallbackProps extends CompPropsWithChild<\"span\"> {\n\t/** Classes merged onto the fallback */\n\tclass?: CompPropsWithChild<\"span\">[\"class\"];\n}\n\nexport type AvatarProps = Props;\nexport type AvatarImageProps = ImageProps;\nexport type AvatarFallbackProps = FallbackProps;\n"
        }
    ],
    "description": "An image of a user with a fallback for initials or an icon, with variants, sizes, and rounded corners."
