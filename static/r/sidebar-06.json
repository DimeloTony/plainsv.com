            "target": "src/routes/(blocks)/sidebar-06/+page.svelte",
            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport AppSidebar from \"./app-sidebar.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 06 example\" description=\"A sidebar with submenus as dropdowns.\" />\n\n<SidebarProvider>\n\t<AppSidebar />\n\t<SidebarInset>\n\t\t<!-- Top bar with the sidebar toggle and the current location. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<SidebarTrigger style=\"margin-left: calc(var(--spacing-xs) * -1)\" />\n\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t<Breadcrumb>\n\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t<BreadcrumbItem class=\"hideOnMobile\"><BreadcrumbLink href=\"#\">Build Your Application</BreadcrumbLink></BreadcrumbItem>\n\t\t\t\t\t<BreadcrumbSeparator class=\"hideOnMobile\" />\n\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage>Data Fetching</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t</BreadcrumbList>\n\t\t\t</Breadcrumb>\n\t\t</header>\n\n\t\t<!-- Placeholder content. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"tiles\">\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t\t<div class=\"tile\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"tile tileLarge\"></div>\n\t\t</div>\n\t</SidebarInset>\n</SidebarProvider>\n\n<style>\n\t/* Top bar of the main content */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tborder-bottom: 1px solid var(--border);\n\t\tpadding-inline: var(--spacing-lg);\n\t\theight: 4rem; /* 64px */\n\t}\n\n\t/* The parent crumb only shows on wider screens */\n\t@media (max-width: 47.99rem) {\n\t\t.pageHeader :global(.hideOnMobile) {\n\t\t\tdisplay: none;\n\t\t}\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* Placeholder content blocks */\n\t.tiles {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: var(--spacing-lg);\n\t}\n\n\t.tile {\n\t\tflex: 1 1 12rem;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\taspect-ratio: 16 / 9;\n\t}\n\n\t.tileLarge {\n\t\tflex: 1;\n\t\taspect-ratio: auto;\n\t\tmin-height: 100svh;\n\t}\n\n\t@media (min-width: 48rem) {\n\t\t.tileLarge {\n\t\t\tmin-height: min-content;\n\t\t}\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-06/app-sidebar.svelte",
            "target": "src/routes/(blocks)/sidebar-06/app-sidebar.svelte",
            "content": "<script lang=\"ts\">\n\timport { Sidebar, SidebarContent, SidebarFooter, SidebarHeader, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarRail, type SidebarProps } from \"#lib/components/ui/sidebar/index.js\";\n\timport { GalleryVerticalEndIcon } from \"@lucide/svelte\";\n\timport NavMain from \"./nav-main.svelte\";\n\timport SidebarOptInForm from \"./sidebar-opt-in-form.svelte\";\n\tconst { ...props }: Omit<SidebarProps, \"children\"> = $props();\n\t// Sample docs navigation, grouped by section.\n\tconst data = {\n\t\tnavMain: [\n\t\t\t{\n\t\t\t\ttitle: \"Getting Started\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Installation\", url: \"#\" },\n\t\t\t\t\t{ title: \"Project Structure\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Build Your Application\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Routing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Data Fetching\", url: \"#\" },\n\t\t\t\t\t{ title: \"Rendering\", url: \"#\" },\n\t\t\t\t\t{ title: \"Caching\", url: \"#\" },\n\t\t\t\t\t{ title: \"Styling\", url: \"#\" },\n\t\t\t\t\t{ title: \"Optimizing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Configuring\", url: \"#\" },\n\t\t\t\t\t{ title: \"Testing\", url: \"#\" },\n\t\t\t\t\t{ title: \"Authentication\", url: \"#\" },\n\t\t\t\t\t{ title: \"Deploying\", url: \"#\" },\n\t\t\t\t\t{ title: \"Upgrading\", url: \"#\" },\n\t\t\t\t\t{ title: \"Examples\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"API Reference\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Components\", url: \"#\" },\n\t\t\t\t\t{ title: \"File Conventions\", url: \"#\" },\n\t\t\t\t\t{ title: \"Functions\", url: \"#\" },\n\t\t\t\t\t{ title: \"next.config.js Options\", url: \"#\" },\n\t\t\t\t\t{ title: \"CLI\", url: \"#\" },\n\t\t\t\t\t{ title: \"Edge Runtime\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\ttitle: \"Architecture\",\n\t\t\t\turl: \"#\",\n\t\t\t\titems: [\n\t\t\t\t\t{ title: \"Accessibility\", url: \"#\" },\n\t\t\t\t\t{ title: \"Fast Refresh\", url: \"#\" },\n\t\t\t\t\t{ title: \"Next.js Compiler\", url: \"#\" },\n\t\t\t\t\t{ title: \"Supported Browsers\", url: \"#\" },\n\t\t\t\t\t{ title: \"Turbopack\", url: \"#\" },\n\t\t\t\t],\n\t\t\t},\n\t\t],\n\t};\n</script>\n\n<Sidebar {...props}>\n\t<!-- Docs logo and version. -->\n\t<SidebarHeader>\n\t\t<SidebarMenu>\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton size=\"lg\" href=\"#\">\n\t\t\t\t\t<span class=\"docsLogo\"><GalleryVerticalEndIcon /></span>\n\t\t\t\t\t<span class=\"docsTitle\">\n\t\t\t\t\t\t<strong>Documentation</strong>\n\t\t\t\t\t\t<span>v1.0.0</span>\n\t\t\t\t\t</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t</SidebarHeader>\n\n\t<!-- Sections that open their pages in a dropdown. -->\n\t<SidebarContent>\n\t\t<NavMain items={data.navMain} />\n\t</SidebarContent>\n\n\t<!-- Newsletter card. -->\n\t<SidebarFooter>\n\t\t<div class=\"optInWrap\">\n\t\t\t<SidebarOptInForm />\n\t\t</div>\n\t</SidebarFooter>\n\t<SidebarRail />\n</Sidebar>\n\n<style>\n\t/* Square docs logo */\n\t.docsLogo {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder-radius: var(--radius-lg);\n\t\tbackground-color: var(--sidebar-primary);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.docsLogo :global(svg) {\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* Name above the version */\n\t.docsTitle {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: calc(var(--spacing-xs) / 2);\n\t\tline-height: 1;\n\t}\n\n\t.docsTitle strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.optInWrap {\n\t\tpadding: var(--spacing-xs);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-06/nav-main.svelte",
            "target": "src/routes/(blocks)/sidebar-06/nav-main.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { EllipsisIcon } from \"@lucide/svelte\";\n\tconst { items }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Sections whose pages open in a dropdown */\n\tinterface Props {\n\t\t/** Sections with their pages */\n\t\titems: { title: string; url: string; items?: { title: string; url: string }[] }[];\n\t}\n</script>\n\n<SidebarGroup>\n\t<SidebarMenu>\n\t\t{#each items as item (item.title)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<!-- The pages open below on mobile and beside the sidebar on desktop. -->\n\t\t\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align={sidebar.isMobile ? \"end\" : \"start\"}>\n\t\t\t\t\t<DropdownMenuTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuButton class=\"sectionButton\" {...props}>\n\t\t\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t\t\t\t<EllipsisIcon class=\"sectionEllipsis\" />\n\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</DropdownMenuTrigger>\n\t\t\t\t\t{#if item.items?.length}\n\t\t\t\t\t\t<DropdownMenuContent rounded=\"lg\" style=\"min-width: 14rem\">\n\t\t\t\t\t\t\t{#each item.items as page (page.title)}\n\t\t\t\t\t\t\t\t<DropdownMenuItem href={page.url}>{page.title}</DropdownMenuItem>\n\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t</DropdownMenuContent>\n\t\t\t\t\t{/if}\n\t\t\t\t</DropdownMenu>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t:global(.sidebar .sidebarMenuButton.sectionButton .sectionEllipsis) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The section stays highlighted while its pages are open */\n\t:global(.sidebar .sidebarMenuButton.sectionButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-06/sidebar-opt-in-form.svelte",
            "target": "src/routes/(blocks)/sidebar-06/sidebar-opt-in-form.svelte",
            "content": "<script lang=\"ts\">\n\timport { Card, CardHeader, CardTitle, CardDescription, CardContent } from \"#lib/components/ui/card/index.js\";\n\timport { SidebarInput } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Button } from \"#lib/components/ui/button/index.js\";\n\n\t/** Keeps the demo form on the page instead of submitting it. */\n\tconst handleSubmit = (e: SubmitEvent) => {\n\t\te.preventDefault();\n\t};\n</script>\n\n<!-- Newsletter sign up in a compact card. -->\n<div class=\"optInForm\">\n\t<Card size=\"md\" class=\"optInCard\">\n\t\t<CardHeader>\n\t\t\t<CardTitle class=\"optInTitle\">Subscribe to our newsletter</CardTitle>\n\t\t\t<CardDescription>Opt-in to receive updates and news about the sidebar.</CardDescription>\n\t\t</CardHeader>\n\t\t<CardContent>\n\t\t\t<form class=\"optInFields\" onsubmit={handleSubmit}>\n\t\t\t\t<SidebarInput type=\"email\" placeholder=\"Email\" aria-label=\"Email\" />\n\t\t\t\t<Button type=\"submit\" class=\"subscribeButton\">Subscribe</Button>\n\t\t\t</form>\n\t\t</CardContent>\n\t</Card>\n</div>\n\n<style>\n\t/* Flat card with tighter spacing */\n\t.optInForm :global(.card.optInCard) {\n\t\tgap: var(--spacing-sm);\n\t\tbox-shadow: none;\n\t}\n\n\t.optInForm :global(.optInTitle) {\n\t\tfont-size: var(--text-sm);\n\t}\n\n\t.optInFields {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: calc(var(--spacing-sm) * 1.25); /* 10px */\n\t}\n\n\t/* Full-width button in the sidebar's primary color */\n\t.optInForm :global(form .button.subscribeButton) {\n\t\tbox-shadow: none;\n\t\tbackground-color: var(--sidebar-primary);\n\t\twidth: 100%;\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n</style>\n"
        }
    ],
