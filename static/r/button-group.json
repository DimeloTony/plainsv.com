            "path": "src/lib/components/ui/button-group/_.svelte",
            "content": "<script lang=\"ts\">\n\timport type { Props } from \"./index.js\";\n\tconst { orientation = \"horizontal\", children, class: className, ...props }: Props = $props();\n</script>\n\n<!-- Joins its children: inner corners turn square and neighbors share a border. -->\n<div class={[\"buttonGroup not-typeset\", className]} role=\"group\" data-orientation={orientation} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base group; children stretch to the tallest one */\n\t.buttonGroup {\n\t\tdisplay: flex;\n\t\talign-items: stretch;\n\t\twidth: fit-content;\n\t}\n\n\t.buttonGroup[data-orientation=\"vertical\"] {\n\t\tflex-direction: column;\n\t}\n\n\t/* A focused child rises above its neighbors so the ring is not covered */\n\t.buttonGroup > :global(*:focus-visible),\n\t.buttonGroup > :global(*:focus-within) {\n\t\tposition: relative;\n\t\tz-index: 1;\n\t}\n\n\t/* Inputs inside the group fill the room left by the buttons */\n\t.buttonGroup > :global(.input) {\n\t\tflex: 1;\n\t}\n\n\t/* Joined corners; [data-orientation] keeps these above the children's own radius */\n\t.buttonGroup[data-orientation=\"horizontal\"] > :global(*:not(:first-child)) {\n\t\tborder-left-width: 0;\n\t\tborder-top-left-radius: 0;\n\t\tborder-bottom-left-radius: 0;\n\t}\n\n\t.buttonGroup[data-orientation=\"horizontal\"] > :global(*:not(:last-child)) {\n\t\tborder-top-right-radius: 0;\n\t\tborder-bottom-right-radius: 0;\n\t}\n\n\t.buttonGroup[data-orientation=\"vertical\"] > :global(*:not(:first-child)) {\n\t\tborder-top-width: 0;\n\t\tborder-top-right-radius: 0;\n\t\tborder-top-left-radius: 0;\n\t}\n\n\t.buttonGroup[data-orientation=\"vertical\"] > :global(*:not(:last-child)) {\n\t\tborder-bottom-right-radius: 0;\n\t\tborder-bottom-left-radius: 0;\n\t}\n\n\t/* Nested groups sit apart instead of joining */\n\t.buttonGroup:has(> :global(.buttonGroup)) {\n\t\tgap: var(--spacing-sm);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/button-group/index.ts",
            "content": "export { default as ButtonGroup } from \"./_.svelte\";\nexport { default as ButtonGroupSeparator } from \"./separator.svelte\";\nexport { default as ButtonGroupText } from \"./text.svelte\";\n\n/** Row or column of buttons, inputs, and selects joined into one control */\nexport interface Props extends CompPropsWithChild<\"div\"> {\n\t/** Direction the children are joined in; defaults to `horizontal` */\n\torientation?: \"horizontal\" | \"vertical\";\n\t/** Classes merged onto the group */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Line between joined children that share a fill, such as two default buttons */\nexport interface SeparatorProps extends CompProps<\"div\"> {\n\t/** Matches the group direction; `vertical` for a horizontal group; defaults to `vertical` */\n\torientation?: \"horizontal\" | \"vertical\";\n\t/** Classes merged onto the separator */\n\tclass?: CompProps<\"div\">[\"class\"];\n}\n\n/** Bordered text joined with the other children, such as a unit or a prefix */\nexport interface TextProps extends CompPropsWithChild<\"div\"> {\n\t/** Height, padding, and text size on the shared scale; match it to the buttons; defaults to `md` */\n\tsize?: UiSize;\n\t/** Classes merged onto the text */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\nexport type ButtonGroupProps = Props;\nexport type ButtonGroupSeparatorProps = SeparatorProps;\nexport type ButtonGroupTextProps = TextProps;\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/button-group/separator.svelte",
            "content": "<script lang=\"ts\">\n\timport type { SeparatorProps } from \"./index.js\";\n\tconst { orientation = \"vertical\", class: className, ...props }: SeparatorProps = $props();\n</script>\n\n<!-- Hairline between joined children; decorative, so screen readers skip it. -->\n<div class={[\"buttonGroupSeparator\", className]} role=\"none\" data-orientation={orientation} {...props}></div>\n\n<style>\n\t/* Base separator; stretches across the group */\n\t.buttonGroupSeparator {\n\t\tposition: relative;\n\t\tflex-shrink: 0;\n\t\talign-self: stretch;\n\t\tmargin: 0;\n\t\tbackground-color: var(--input);\n\t}\n\n\t.buttonGroupSeparator[data-orientation=\"vertical\"] {\n\t\twidth: 1px;\n\t}\n\n\t.buttonGroupSeparator[data-orientation=\"horizontal\"] {\n\t\theight: 1px;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/button-group/text.svelte",
            "content": "<script lang=\"ts\">\n\timport type { TextProps } from \"./index.js\";\n\tconst { size = \"md\", children, class: className, ...props }: TextProps = $props();\n</script>\n\n<!-- Static label joined with the buttons, such as a prefix or unit. -->\n<div class={[\"buttonGroupText\", className]} data-size={size} {...props}>\n\t{@render children()}\n</div>\n\n<style>\n\t/* Base text */\n\t.buttonGroupText {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tbox-sizing: border-box;\n\t\tbox-shadow: 0 1px 2px 0 color-mix(in oklab, var(--foreground) 5%, transparent);\n\t\tborder: 1px solid var(--border);\n\t\tbackground-color: var(--muted);\n\t\tcolor: var(--foreground);\n\t\tfont-weight: 500;\n\t\twhite-space: nowrap;\n\t}\n\n\t.buttonGroupText :global(svg) {\n\t\tflex-shrink: 0;\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tpointer-events: none;\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.buttonGroupText[data-size=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t\tpadding-inline: var(--spacing-lg);\n\t\tmin-height: var(--control-height-lg);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Medium — default */\n\t.buttonGroupText[data-size=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t\tpadding-inline: var(--spacing-lg);\n\t\tmin-height: var(--control-height-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Small */\n\t.buttonGroupText[data-size=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t\tpadding-inline: var(--spacing-md);\n\t\tmin-height: var(--control-height-sm);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Extra small */\n\t.buttonGroupText[data-size=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t\tpadding-inline: var(--spacing-sm);\n\t\tmin-height: var(--control-height-xs);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n</style>\n"
        }
    ],
    "description": "A row or column of buttons, inputs, and selects joined into one control, with separators and text."
