{
    "name": "native-select",
    "files": [
        {
            "type": "file",
            "path": "src/lib/components/ui/native-select/_.svelte",
            "content": "<script lang=\"ts\">\n\timport { ChevronDownIcon } from \"@lucide/svelte\";\n\timport type { Props } from \"./index.js\";\n\tlet { value = $bindable(), size = \"md\", rounded, children, class: className, ...props }: Props = $props();\n</script>\n\n<!-- Native select with the browser arrow replaced by a chevron; the native picker opens on click. -->\n<div class={[\"nativeSelect not-typeset\", className]} data-size={size} data-rounded={rounded}>\n\t<select class=\"nativeSelectControl\" bind:value {...props}>\n\t\t{@render children()}\n\t</select>\n\t<ChevronDownIcon aria-hidden=\"true\" />\n</div>\n\n<style>\n\t/* Wrapper that places the chevron over the select */\n\t.nativeSelect {\n\t\tdisplay: inline-flex;\n\t\tposition: relative;\n\t\talign-items: center;\n\t\twidth: fit-content;\n\t\tmin-width: 0;\n\t}\n\n\t/* Base select; styled like the input */\n\t.nativeSelectControl {\n\t\tappearance: none;\n\t\ttransition-duration: 150ms;\n\t\ttransition-property: color, border-color, box-shadow, opacity;\n\t\ttransition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n\t\tcursor: pointer;\n\t\tbox-sizing: border-box;\n\t\toutline: none;\n\t\tbox-shadow: 0 1px 2px 0 color-mix(in oklab, var(--foreground) 5%, transparent);\n\t\tborder: 1px solid var(--input);\n\t\tborder-radius: inherit;\n\t\tbackground-color: transparent;\n\t\twidth: 100%;\n\t\tmin-width: 0;\n\t\tcolor: var(--foreground);\n\t\tfont: inherit;\n\t}\n\n\t:global(.dark) .nativeSelectControl {\n\t\tbackground-color: color-mix(in oklab, var(--input) 30%, transparent);\n\t}\n\n\t/* The open list uses the popover colors in both themes */\n\t.nativeSelectControl :global(option),\n\t.nativeSelectControl :global(optgroup) {\n\t\tbackground-color: var(--popover);\n\t\tcolor: var(--popover-foreground);\n\t}\n\n\t/* Chevron in the end padding; clicks pass through to the select */\n\t.nativeSelect :global(svg) {\n\t\tposition: absolute;\n\t\tright: var(--spacing-md);\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tpointer-events: none;\n\t\tcolor: var(--muted-foreground);\n\t}\n\n\t/* =============== States =============== */\n\n\t/* Keyboard and pointer focus ring */\n\t.nativeSelectControl:focus-visible {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);\n\t\tborder-color: var(--ring);\n\t}\n\n\t/* Invalid state from aria-invalid */\n\t.nativeSelectControl[aria-invalid=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 20%, transparent);\n\t\tborder-color: var(--destructive);\n\t}\n\n\t:global(.dark) .nativeSelectControl[aria-invalid=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 40%, transparent);\n\t}\n\n\t/* Disabled state */\n\t.nativeSelectControl:disabled {\n\t\topacity: 50%;\n\t\tcursor: not-allowed;\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.nativeSelect[data-size=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t.nativeSelect[data-size=\"lg\"] .nativeSelectControl {\n\t\tpadding-right: calc(var(--spacing-md) * 2 + 1rem); /* room for the 16px chevron */\n\t\tpadding-left: var(--spacing-md);\n\t\theight: var(--control-height-lg);\n\t}\n\n\t/* Medium — default */\n\t.nativeSelect[data-size=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t.nativeSelect[data-size=\"md\"] .nativeSelectControl {\n\t\tpadding-right: calc(var(--spacing-md) * 2 + 1rem); /* room for the 16px chevron */\n\t\tpadding-left: var(--spacing-md);\n\t\theight: var(--control-height-md);\n\t}\n\n\t/* Small */\n\t.nativeSelect[data-size=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t.nativeSelect[data-size=\"sm\"] .nativeSelectControl {\n\t\tpadding-right: calc(var(--spacing-sm) * 2 + var(--text-sm)); /* room for the chevron */\n\t\tpadding-left: var(--spacing-sm);\n\t\theight: var(--control-height-sm);\n\t}\n\n\t.nativeSelect[data-size=\"sm\"] :global(svg) {\n\t\tright: var(--spacing-sm);\n\t\twidth: var(--text-sm);\n\t\theight: var(--text-sm);\n\t}\n\n\t/* Extra small */\n\t.nativeSelect[data-size=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n\n\t.nativeSelect[data-size=\"xs\"] .nativeSelectControl {\n\t\tpadding-right: calc(var(--spacing-xs) * 2 + var(--text-xs)); /* room for the chevron */\n\t\tpadding-left: var(--spacing-xs);\n\t\theight: var(--control-height-xs);\n\t}\n\n\t.nativeSelect[data-size=\"xs\"] :global(svg) {\n\t\tright: var(--spacing-xs);\n\t\twidth: var(--text-xs);\n\t\theight: var(--text-xs);\n\t}\n\n\t/* =============== Rounded =============== */\n\n\t/* Overrides the size radius; the select inherits it from the wrapper. Must stay after the size rules */\n\t.nativeSelect[data-rounded=\"xs\"] {\n\t\tborder-radius: var(--radius-xs);\n\t}\n\n\t.nativeSelect[data-rounded=\"sm\"] {\n\t\tborder-radius: var(--radius-sm);\n\t}\n\n\t.nativeSelect[data-rounded=\"md\"] {\n\t\tborder-radius: var(--radius-md);\n\t}\n\n\t.nativeSelect[data-rounded=\"lg\"] {\n\t\tborder-radius: var(--radius-lg);\n\t}\n\n\t.nativeSelect[data-rounded=\"xl\"] {\n\t\tborder-radius: var(--radius-xl);\n\t}\n\n\t.nativeSelect[data-rounded=\"2xl\"] {\n\t\tborder-radius: var(--radius-2xl);\n\t}\n\n\t.nativeSelect[data-rounded=\"3xl\"] {\n\t\tborder-radius: var(--radius-3xl);\n\t}\n\n\t.nativeSelect[data-rounded=\"4xl\"] {\n\t\tborder-radius: var(--radius-4xl);\n\t}\n\n\t.nativeSelect[data-rounded=\"pill\"] {\n\t\tborder-radius: var(--radius-pill);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/native-select/index.ts",
            "content": "export { default as NativeSelect } from \"./_.svelte\";\nexport { default as NativeSelectOption } from \"./option.svelte\";\nexport { default as NativeSelectOptGroup } from \"./opt-group.svelte\";\n\n/** Native `select` styled like the input, with a chevron */\nexport interface Props extends Omit<CompPropsWithChild<\"select\">, \"size\" | \"value\"> {\n\t/** Value of the selected option; supports `bind:value` */\n\tvalue?: CompPropsWithChild<\"select\">[\"value\"];\n\t/** Height, padding, and text size on the shared scale; defaults to `md` */\n\tsize?: UiSize;\n\t/** Corner radius; follows `size` when omitted */\n\trounded?: UiRounded;\n\t/** Classes merged onto the wrapper that holds the select and the chevron */\n\tclass?: CompPropsWithChild<\"select\">[\"class\"];\n}\n\n/** One choice; renders an `option` */\nexport interface OptionProps extends CompPropsWithChild<\"option\"> {\n\t/** Classes merged onto the option */\n\tclass?: CompPropsWithChild<\"option\">[\"class\"];\n}\n\n/** Labeled group of options; renders an `optgroup` */\nexport interface OptGroupProps extends CompPropsWithChild<\"optgroup\"> {\n\t/** Classes merged onto the group */\n\tclass?: CompPropsWithChild<\"optgroup\">[\"class\"];\n}\n\nexport type NativeSelectProps = Props;\nexport type NativeSelectOptionProps = OptionProps;\nexport type NativeSelectOptGroupProps = OptGroupProps;\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/native-select/opt-group.svelte",
            "content": "<script lang=\"ts\">\n\timport type { OptGroupProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: OptGroupProps = $props();\n</script>\n\n<!-- Labeled group of options; set `label` for its heading. -->\n<optgroup class={className} {...props}>\n\t{@render children()}\n</optgroup>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/native-select/option.svelte",
            "content": "<script lang=\"ts\">\n\timport type { OptionProps } from \"./index.js\";\n\tconst { children, class: className, ...props }: OptionProps = $props();\n</script>\n\n<!-- One choice in the select. -->\n<option class={className} {...props}>{@render children()}</option>\n"
        }
    ],
    "devDependencies": [
        "@lucide/svelte"
    ],
    "description": "A native select styled like the input, with a chevron, sizes, rounded corners, and states."
