        {
            "type": "file",
            "path": "src/lib/components/ui/input-otp/index.ts",
            "content": "export { default as InputOTP } from \"./_.svelte\";\nexport { default as InputOTPGroup } from \"./group.svelte\";\nexport { default as InputOTPSlot } from \"./slot.svelte\";\nexport { default as InputOTPSeparator } from \"./separator.svelte\";\nexport { REGEXP_ONLY_DIGITS, REGEXP_ONLY_CHARS, REGEXP_ONLY_DIGITS_AND_CHARS } from \"./patterns.js\";\n\n/** One-time code field; a transparent native input over the slots takes typing, pasting, and autofill */\nexport interface Props extends Omit<CompProps<\"input\">, \"size\" | \"value\" | \"type\" | \"maxlength\" | \"pattern\" | \"class\"> {\n\t/** Characters entered so far; supports `bind:value` */\n\tvalue?: string;\n\t/** Number of characters the code needs; match it to the number of slots */\n\tmaxlength: number;\n\t/** Regular expression source the whole value must match; defaults to `REGEXP_ONLY_DIGITS` */\n\tpattern?: string;\n\t/** Called with the new value when it changes */\n\tonValueChange?: (value: string) => void;\n\t/** Called with the value once every slot is filled */\n\tonComplete?: (value: string) => void;\n\t/** Slot size, gap, and text size on the shared scale; defaults to `md` */\n\tsize?: UiSize;\n\t/** Corner radius of each group's outer slots; follows `size` when omitted */\n\trounded?: UiRounded;\n\t/** Groups, slots, and separators */\n\tchildren: Snippet;\n\t/** Classes merged onto the root container */\n\tclass?: CompProps<\"div\">[\"class\"];\n}\n\n/** Row of joined slots */\nexport interface GroupProps extends CompPropsWithChild<\"div\"> {\n\t/** Classes merged onto the group */\n\tclass?: CompPropsWithChild<\"div\">[\"class\"];\n}\n\n/** Box that shows the character at `index` */\nexport interface SlotProps extends CompProps<\"div\"> {\n\t/** Position of the character in the value, starting at 0 */\n\tindex: number;\n\t/** Size of this slot; overrides the input's `size` */\n\tsize?: UiSize;\n\t/** Corner radius of this slot's outer corners; overrides the input's `rounded` */\n\trounded?: UiRounded;\n\t/** Classes merged onto the slot */\n\tclass?: CompProps<\"div\">[\"class\"];\n}\n\n/** Divider between groups; renders a dash by default */\nexport interface SeparatorProps extends CompProps<\"div\"> {\n\t/** Custom divider content in place of the dash */\n\tchildren?: Snippet;\n\t/** Classes merged onto the separator */\n\tclass?: CompProps<\"div\">[\"class\"];\n}\n\nexport type InputOTPProps = Props;\nexport type InputOTPGroupProps = GroupProps;\nexport type InputOTPSlotProps = SlotProps;\nexport type InputOTPSeparatorProps = SeparatorProps;\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/input-otp/patterns.ts",
            "content": "/** Pattern that accepts digits only; the default */\nexport const REGEXP_ONLY_DIGITS = \"^\\\\d+$\";\n/** Pattern that accepts letters only */\nexport const REGEXP_ONLY_CHARS = \"^[a-zA-Z]+$\";\n/** Pattern that accepts letters and digits */\nexport const REGEXP_ONLY_DIGITS_AND_CHARS = \"^[a-zA-Z0-9]+$\";\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/input-otp/separator.svelte",
            "content": "<script lang=\"ts\">\n\timport { useCompCtx } from \"./ctx.svelte.js\";\n\timport type { SeparatorProps } from \"./index.js\";\n\timport { MinusIcon } from \"@lucide/svelte\";\n\tconst { children, class: className, ...props }: SeparatorProps = $props();\n\tconst ctx = useCompCtx();\n</script>\n\n<!-- Divider between groups; a dash unless custom content is passed. -->\n<div class={[\"inputOtpSeparator\", className]} role=\"separator\" data-size={ctx.size} {...props}>\n\t{#if children}\n\t\t{@render children()}\n\t{:else}\n\t\t<MinusIcon />\n\t{/if}\n</div>\n\n<style>\n\t/* Base separator */\n\t.inputOtpSeparator {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tpointer-events: none;\n\t\tcolor: var(--foreground);\n\t}\n\n\t.inputOtpSeparator :global(svg) {\n\t\tflex-shrink: 0;\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Extra small */\n\t.inputOtpSeparator[data-size=\"xs\"] :global(svg) {\n\t\twidth: 0.75rem; /* 12px */\n\t\theight: 0.75rem; /* 12px */\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/lib/components/ui/input-otp/slot.svelte",
            "content": "<script lang=\"ts\">\n\timport { useCompCtx } from \"./ctx.svelte.js\";\n\timport type { SlotProps } from \"./index.js\";\n\tconst { index, size, rounded, class: className, ...props }: SlotProps = $props();\n\tconst ctx = useCompCtx();\n\tconst char = $derived(ctx.value[index] ?? \"\");\n\tconst isActive = $derived(ctx.focused && ctx.activeIndex === index);\n</script>\n\n<!-- One character of the code; the active slot draws a blinking caret while it is empty. -->\n<div class={[\"inputOtpSlot\", className]} data-active={isActive} data-invalid={ctx.invalid} data-size={size ?? ctx.size} data-rounded={rounded ?? ctx.rounded} {...props}>\n\t{char}\n\t{#if isActive && !char}\n\t\t<span class=\"inputOtpCaret\" aria-hidden=\"true\"></span>\n\t{/if}\n</div>\n\n<style>\n\t/* Base slot; neighbors share a border, and clicks pass through to the native input */\n\t.inputOtpSlot {\n\t\tdisplay: flex;\n\t\tposition: relative;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\ttransition-duration: 150ms;\n\t\ttransition-property: border-color, box-shadow;\n\t\ttransition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n\t\tbox-sizing: border-box;\n\t\tbox-shadow: 0 1px 2px 0 color-mix(in oklab, var(--foreground) 5%, transparent);\n\t\tborder-top: 1px solid var(--input);\n\t\tborder-right: 1px solid var(--input);\n\t\tborder-bottom: 1px solid var(--input);\n\t\tpointer-events: none;\n\t\tcolor: var(--foreground);\n\t}\n\n\t:global(.dark) .inputOtpSlot {\n\t\tbackground-color: color-mix(in oklab, var(--input) 30%, transparent);\n\t}\n\n\t/* Outer slots close the group's border and round its corners */\n\t.inputOtpSlot:first-child {\n\t\tborder-left: 1px solid var(--input);\n\t\tborder-top-left-radius: var(--input-otp-slot-radius);\n\t\tborder-bottom-left-radius: var(--input-otp-slot-radius);\n\t}\n\n\t.inputOtpSlot:last-child {\n\t\tborder-top-right-radius: var(--input-otp-slot-radius);\n\t\tborder-bottom-right-radius: var(--input-otp-slot-radius);\n\t}\n\n\t/* Fake caret centered in the empty active slot */\n\t.inputOtpCaret {\n\t\tanimation: inputOtpCaretBlink 1.25s ease-out infinite;\n\t\tbackground-color: var(--foreground);\n\t\twidth: 1px;\n\t\theight: 1rem; /* 16px */\n\t}\n\n\t@keyframes inputOtpCaretBlink {\n\t\t0%,\n\t\t70%,\n\t\t100% {\n\t\t\topacity: 1;\n\t\t}\n\t\t20%,\n\t\t50% {\n\t\t\topacity: 0;\n\t\t}\n\t}\n\n\t/* =============== States =============== */\n\n\t/* Focus ring on the slot that receives the next character; raised above its neighbors */\n\t.inputOtpSlot[data-active=\"true\"] {\n\t\tz-index: 1;\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent);\n\t\tborder-color: var(--ring);\n\t}\n\n\t/* Invalid state from aria-invalid on the root */\n\t.inputOtpSlot[data-invalid=\"true\"] {\n\t\tborder-color: var(--destructive);\n\t}\n\n\t.inputOtpSlot[data-invalid=\"true\"][data-active=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 20%, transparent);\n\t}\n\n\t:global(.dark) .inputOtpSlot[data-invalid=\"true\"][data-active=\"true\"] {\n\t\tbox-shadow: 0 0 0 3px color-mix(in oklab, var(--destructive) 40%, transparent);\n\t}\n\n\t/* =============== Sizes =============== */\n\n\t/* Large */\n\t.inputOtpSlot[data-size=\"lg\"] {\n\t\t--input-otp-slot-radius: var(--radius-lg);\n\t\twidth: var(--control-height-lg);\n\t\theight: var(--control-height-lg);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Medium — default */\n\t.inputOtpSlot[data-size=\"md\"] {\n\t\t--input-otp-slot-radius: var(--radius-md);\n\t\twidth: var(--control-height-md);\n\t\theight: var(--control-height-md);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Small */\n\t.inputOtpSlot[data-size=\"sm\"] {\n\t\t--input-otp-slot-radius: var(--radius-sm);\n\t\twidth: var(--control-height-sm);\n\t\theight: var(--control-height-sm);\n\t\tfont-size: var(--text-sm);\n\t\tline-height: var(--line-height-sm);\n\t}\n\n\t/* Extra small */\n\t.inputOtpSlot[data-size=\"xs\"] {\n\t\t--input-otp-slot-radius: var(--radius-xs);\n\t\twidth: var(--control-height-xs);\n\t\theight: var(--control-height-xs);\n\t\tfont-size: var(--text-xs);\n\t\tline-height: var(--line-height-xs);\n\t}\n\n\t.inputOtpSlot[data-size=\"xs\"] .inputOtpCaret {\n\t\theight: 0.75rem; /* 12px */\n\t}\n\n\t/* =============== Rounded =============== */\n\n\t/* Overrides the size radius of the outer slots; must stay after the size rules */\n\t.inputOtpSlot[data-rounded=\"xs\"] {\n\t\t--input-otp-slot-radius: var(--radius-xs);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"sm\"] {\n\t\t--input-otp-slot-radius: var(--radius-sm);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"md\"] {\n\t\t--input-otp-slot-radius: var(--radius-md);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"lg\"] {\n\t\t--input-otp-slot-radius: var(--radius-lg);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"xl\"] {\n\t\t--input-otp-slot-radius: var(--radius-xl);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"2xl\"] {\n\t\t--input-otp-slot-radius: var(--radius-2xl);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"3xl\"] {\n\t\t--input-otp-slot-radius: var(--radius-3xl);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"4xl\"] {\n\t\t--input-otp-slot-radius: var(--radius-4xl);\n\t}\n\n\t.inputOtpSlot[data-rounded=\"pill\"] {\n\t\t--input-otp-slot-radius: var(--radius-pill);\n\t}\n</style>\n"
        }
    ],
    "devDependencies": [
