            "path": "src/routes/(custom)/examples/sidebar-15/+page.svelte",
            "target": "src/routes/(blocks)/sidebar-15/+page.svelte",
            "content": "<script lang=\"ts\">\n\timport { PageMeta } from \"#lib/components/shared/index.js\";\n\timport { SidebarProvider, SidebarInset, SidebarTrigger } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbPage } from \"#lib/components/ui/breadcrumb/index.js\";\n\timport { Separator } from \"#lib/components/ui/separator/index.js\";\n\timport SidebarLeft from \"./sidebar-left.svelte\";\n\timport SidebarRight from \"./sidebar-right.svelte\";\n</script>\n\n<PageMeta title=\"Sidebar 15 example\" description=\"A left and right sidebar.\" />\n\n<SidebarProvider>\n\t<SidebarLeft />\n\t<SidebarInset>\n\t\t<!-- Sticky top bar with the sidebar toggle and the page title. -->\n\t\t<header class=\"pageHeader\">\n\t\t\t<div class=\"pageHeaderStart\">\n\t\t\t\t<SidebarTrigger />\n\t\t\t\t<Separator orientation=\"vertical\" style=\"align-self: center; margin-right: var(--spacing-sm); height: 1rem\" />\n\t\t\t\t<Breadcrumb>\n\t\t\t\t\t<BreadcrumbList>\n\t\t\t\t\t\t<BreadcrumbItem><BreadcrumbPage class=\"pageTitle\">Project Management & Task Tracking</BreadcrumbPage></BreadcrumbItem>\n\t\t\t\t\t</BreadcrumbList>\n\t\t\t\t</Breadcrumb>\n\t\t\t</div>\n\t\t</header>\n\n\t\t<!-- Placeholder document. -->\n\t\t<div class=\"pageBody\">\n\t\t\t<div class=\"block blockShort\"></div>\n\t\t\t<div class=\"block blockTall\"></div>\n\t\t</div>\n\t</SidebarInset>\n\t<SidebarRight />\n</SidebarProvider>\n\n<style>\n\t/* Top bar that stays in view while the content scrolls */\n\t.pageHeader {\n\t\tdisplay: flex;\n\t\tposition: sticky;\n\t\ttop: 0;\n\t\tflex-shrink: 0;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tz-index: 1;\n\t\tbackground-color: var(--background);\n\t\theight: 3.5rem; /* 56px */\n\t}\n\n\t.pageHeaderStart {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tpadding-inline: var(--spacing-md);\n\t\tmin-width: 0;\n\t}\n\n\t/* The page title stays on one line */\n\t.pageHeaderStart :global(.pageTitle) {\n\t\tdisplay: -webkit-box;\n\t\t-webkit-box-orient: vertical;\n\t\t-webkit-line-clamp: 1;\n\t\tline-clamp: 1;\n\t\toverflow: hidden;\n\t}\n\n\t.pageBody {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tgap: var(--spacing-lg);\n\t\tpadding: var(--spacing-lg);\n\t}\n\n\t/* Placeholder blocks in a centered column */\n\t.block {\n\t\tmargin-inline: auto;\n\t\tborder-radius: var(--radius-xl);\n\t\tbackground-color: color-mix(in oklab, var(--muted) 50%, transparent);\n\t\twidth: 100%;\n\t\tmax-width: 48rem; /* 768px */\n\t}\n\n\t.blockShort {\n\t\theight: 6rem; /* 96px */\n\t}\n\n\t.blockTall {\n\t\theight: 100svh;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/calendars.svelte",
            "target": "src/routes/(blocks)/sidebar-15/calendars.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarSeparator } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon, CheckIcon } from \"@lucide/svelte\";\n\tconst { calendars }: Props = $props();\n\t/** Calendar lists whose label opens and closes them */\n\tinterface Props {\n\t\t/** Lists with the calendars in each */\n\t\tcalendars: { name: string; items: string[] }[];\n\t}\n</script>\n\n{#each calendars as calendar, index (calendar.name)}\n\t<SidebarGroup>\n\t\t<Collapsible defaultOpen={index === 0}>\n\t\t\t<!-- The label is the toggle. -->\n\t\t\t<CollapsibleTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarGroupLabel class=\"calendarsToggle\" {...props}>\n\t\t\t\t\t\t{calendar.name}\n\t\t\t\t\t\t<ChevronRightIcon class=\"calendarsChevron\" />\n\t\t\t\t\t</SidebarGroupLabel>\n\t\t\t\t{/snippet}\n\t\t\t</CollapsibleTrigger>\n\t\t\t<CollapsibleContent>\n\t\t\t\t<SidebarGroupContent>\n\t\t\t\t\t<SidebarMenu>\n\t\t\t\t\t\t{#each calendar.items as item, itemIndex (item)}\n\t\t\t\t\t\t\t<!-- The first two calendars of each list are shown. -->\n\t\t\t\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t\t\t\t<SidebarMenuButton>\n\t\t\t\t\t\t\t\t\t<span class=\"calendarCheck\" data-active={itemIndex < 2 || undefined}><CheckIcon /></span>\n\t\t\t\t\t\t\t\t\t<span>{item}</span>\n\t\t\t\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t\t\t</SidebarMenuItem>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</SidebarMenu>\n\t\t\t\t</SidebarGroupContent>\n\t\t\t</CollapsibleContent>\n\t\t</Collapsible>\n\t</SidebarGroup>\n\t<SidebarSeparator style=\"margin-inline: 0\" />\n{/each}\n\n<style>\n\t/* The toggle uses the full text size and color */\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle) {\n\t\tcolor: var(--sidebar-foreground);\n\t\tfont-size: var(--text-sm);\n\t}\n\n\t/* Chevron at the end that points down while the list is open */\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle .calendarsChevron) {\n\t\ttransition: transform 200ms ease;\n\t\tmargin-left: auto;\n\t}\n\n\t:global(.sidebar .sidebarGroupLabel.calendarsToggle[data-state=\"open\"] .calendarsChevron) {\n\t\ttransform: rotate(90deg);\n\t}\n\n\t/* Check box that fills with the primary color while the calendar is shown */\n\t.calendarCheck {\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tborder: 1px solid var(--sidebar-border);\n\t\tborder-radius: var(--radius-xs);\n\t\twidth: 1rem; /* 16px */\n\t\theight: 1rem; /* 16px */\n\t\tcolor: var(--sidebar-primary-foreground);\n\t}\n\n\t.calendarCheck :global(svg) {\n\t\tdisplay: none;\n\t\twidth: 0.75rem; /* 12px */\n\t\theight: 0.75rem; /* 12px */\n\t}\n\n\t.calendarCheck[data-active] {\n\t\tborder-color: var(--sidebar-primary);\n\t\tbackground-color: var(--sidebar-primary);\n\t}\n\n\t.calendarCheck[data-active] :global(svg) {\n\t\tdisplay: block;\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/date-picker.svelte",
            "target": "src/routes/(blocks)/sidebar-15/date-picker.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Calendar } from \"#lib/components/ui/calendar/index.js\";\n\t// The 12th of this month starts selected.\n\tconst today = new Date();\n\tlet date = $state(new Date(today.getFullYear(), today.getMonth(), 12));\n</script>\n\n<!-- Month calendar with month and year selects, on the sidebar background. -->\n<SidebarGroup style=\"padding-inline: 0\">\n\t<SidebarGroupContent>\n\t\t<Calendar bind:value={date} captionLayout=\"dropdown\" variant=\"ghost\" style=\"margin-inline: auto\" />\n\t</SidebarGroupContent>\n</SidebarGroup>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/nav-favorites.svelte",
            "target": "src/routes/(blocks)/sidebar-15/nav-favorites.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { EllipsisIcon, StarOffIcon, LinkIcon, ArrowUpRightIcon, Trash2Icon } from \"@lucide/svelte\";\n\tconst { favorites }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Favorite pages with a menu of actions on each; hidden while collapsed to icons */\n\tinterface Props {\n\t\t/** Pages with an emoji */\n\t\tfavorites: { name: string; url: string; emoji: string }[];\n\t}\n</script>\n\n<SidebarGroup class=\"favoritesGroup\">\n\t<SidebarGroupLabel>Favorites</SidebarGroupLabel>\n\t<SidebarMenu>\n\t\t{#each favorites as item (item.name)}\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton href={item.url} title={item.name}>\n\t\t\t\t\t<span>{item.emoji}</span>\n\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t<!-- Actions menu; opens below on mobile and beside the sidebar on desktop. -->\n\t\t\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align={sidebar.isMobile ? \"end\" : \"start\"}>\n\t\t\t\t\t<DropdownMenuTrigger>\n\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"favoriteAction\" aria-label=\"More for {item.name}\" {...props}><EllipsisIcon /></SidebarMenuAction>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</DropdownMenuTrigger>\n\t\t\t\t\t<DropdownMenuContent rounded=\"lg\" style=\"min-width: 14rem\">\n\t\t\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t\t\t<DropdownMenuItem><StarOffIcon /> Remove from Favorites</DropdownMenuItem>\n\t\t\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t\t\t<DropdownMenuItem><LinkIcon /> Copy Link</DropdownMenuItem>\n\t\t\t\t\t\t\t<DropdownMenuItem><ArrowUpRightIcon /> Open in New Tab</DropdownMenuItem>\n\t\t\t\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t\t\t\t<DropdownMenuItem><Trash2Icon /> Delete</DropdownMenuItem>\n\t\t\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t\t</DropdownMenuContent>\n\t\t\t\t</DropdownMenu>\n\t\t\t</SidebarMenuItem>\n\t\t{/each}\n\n\t\t<!-- Muted link to the rest of the favorites. -->\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton class=\"moreButton\">\n\t\t\t\t<EllipsisIcon />\n\t\t\t\t<span>More</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t</SidebarMenu>\n</SidebarGroup>\n\n<style>\n\t/* Collapsed to icons, the favorites hide */\n\t:global(.sidebar[data-collapsible=\"icon\"] .sidebarGroup.favoritesGroup) {\n\t\tdisplay: none;\n\t}\n\n\t/* The action stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuAction.favoriteAction[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--muted);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.moreButton) {\n\t\tcolor: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/nav-main.svelte",
            "target": "src/routes/(blocks)/sidebar-15/nav-main.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\tconst { items }: Props = $props();\n\t/** Main links under the team switcher */\n\tinterface Props {\n\t\t/** Links with their icons, one marked as the current page */\n\t\titems: { title: string; url: string; icon: Component; isActive?: boolean }[];\n\t}\n</script>\n\n<SidebarMenu>\n\t{#each items as item (item.title)}\n\t\t<SidebarMenuItem>\n\t\t\t<SidebarMenuButton href={item.url} isActive={item.isActive}>\n\t\t\t\t<item.icon />\n\t\t\t\t<span>{item.title}</span>\n\t\t\t</SidebarMenuButton>\n\t\t</SidebarMenuItem>\n\t{/each}\n</SidebarMenu>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/nav-secondary.svelte",
            "target": "src/routes/(blocks)/sidebar-15/nav-secondary.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarMenu, SidebarMenuBadge, SidebarMenuButton, SidebarMenuItem } from \"#lib/components/ui/sidebar/index.js\";\n\tconst { items, ...props }: Props = $props();\n\t/** Secondary links, such as settings and help, with optional counts */\n\tinterface Props extends CompProps<\"div\"> {\n\t\t/** Links with their icons and an optional badge */\n\t\titems: { title: string; url: string; icon: Component; badge?: string }[];\n\t}\n</script>\n\n<SidebarGroup {...props}>\n\t<SidebarGroupContent>\n\t\t<SidebarMenu>\n\t\t\t{#each items as item (item.title)}\n\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t<SidebarMenuButton href={item.url}>\n\t\t\t\t\t\t<item.icon />\n\t\t\t\t\t\t<span>{item.title}</span>\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t\t{#if item.badge}\n\t\t\t\t\t\t<SidebarMenuBadge>{item.badge}</SidebarMenuBadge>\n\t\t\t\t\t{/if}\n\t\t\t\t</SidebarMenuItem>\n\t\t\t{/each}\n\t\t</SidebarMenu>\n\t</SidebarGroupContent>\n</SidebarGroup>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/nav-user.svelte",
            "target": "src/routes/(blocks)/sidebar-15/nav-user.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar } from \"#lib/components/ui/sidebar/index.js\";\n\timport { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator } from \"#lib/components/ui/dropdown-menu/index.js\";\n\timport { Avatar, AvatarFallback } from \"#lib/components/ui/avatar/index.js\";\n\timport { ChevronsUpDownIcon, SparklesIcon, BadgeCheckIcon, CreditCardIcon, BellIcon, LogOutIcon } from \"@lucide/svelte\";\n\tconst { user }: Props = $props();\n\tconst sidebar = useSidebar();\n\t/** Signed-in user shown in the sidebar footer */\n\tinterface Props {\n\t\t/** Name, email, and avatar initials */\n\t\tuser: { name: string; email: string; initials: string };\n\t}\n</script>\n\n<SidebarMenu>\n\t<SidebarMenuItem>\n\t\t<DropdownMenu side={sidebar.isMobile ? \"bottom\" : \"right\"} align=\"start\" sideOffset={4}>\n\t\t\t<!-- User button with the avatar, name, and email. -->\n\t\t\t<DropdownMenuTrigger>\n\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t<SidebarMenuButton size=\"lg\" class=\"userButton\" {...props}>\n\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<ChevronsUpDownIcon class=\"userChevron\" />\n\t\t\t\t\t</SidebarMenuButton>\n\t\t\t\t{/snippet}\n\t\t\t</DropdownMenuTrigger>\n\n\t\t\t<!-- Account menu. -->\n\t\t\t<DropdownMenuContent style=\"min-width: 14rem\">\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuLabel>\n\t\t\t\t\t\t<span class=\"userLabel\">\n\t\t\t\t\t\t\t<Avatar size=\"sm\" rounded=\"lg\"><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n\t\t\t\t\t\t\t<span class=\"twoLines\">\n\t\t\t\t\t\t\t\t<strong>{user.name}</strong>\n\t\t\t\t\t\t\t\t<span>{user.email}</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</DropdownMenuLabel>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><SparklesIcon /> Upgrade to Pro</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuGroup>\n\t\t\t\t\t<DropdownMenuItem><BadgeCheckIcon /> Account</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><CreditCardIcon /> Billing</DropdownMenuItem>\n\t\t\t\t\t<DropdownMenuItem><BellIcon /> Notifications</DropdownMenuItem>\n\t\t\t\t</DropdownMenuGroup>\n\t\t\t\t<DropdownMenuSeparator />\n\t\t\t\t<DropdownMenuItem><LogOutIcon /> Log out</DropdownMenuItem>\n\t\t\t</DropdownMenuContent>\n\t\t</DropdownMenu>\n\t</SidebarMenuItem>\n</SidebarMenu>\n\n<style>\n\t/* Name above the email, both truncated */\n\t.twoLines {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t\tflex-direction: column;\n\t\tmin-width: 0;\n\t\tfont-size: var(--text-sm);\n\t\tline-height: 1.25;\n\t\ttext-align: left;\n\t}\n\n\t.twoLines strong,\n\t.twoLines span {\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t}\n\n\t.twoLines strong {\n\t\tfont-weight: 500;\n\t}\n\n\t.twoLines span {\n\t\tfont-size: var(--text-xs);\n\t}\n\n\t/* Avatar and text in the menu heading */\n\t.userLabel {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: var(--spacing-sm);\n\t\tcolor: var(--foreground);\n\t\tfont-weight: 400;\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.userButton .userChevron) {\n\t\tmargin-left: auto;\n\t}\n\n\t/* The button stays highlighted while its menu is open */\n\t:global(.sidebar .sidebarMenuButton.userButton[aria-expanded=\"true\"]) {\n\t\tbackground-color: var(--sidebar-accent);\n\t\tcolor: var(--sidebar-accent-foreground);\n\t}\n</style>\n"
        },
        {
            "type": "file",
            "path": "src/routes/(custom)/examples/sidebar-15/nav-workspaces.svelte",
            "target": "src/routes/(blocks)/sidebar-15/nav-workspaces.svelte",
            "content": "<script lang=\"ts\">\n\timport { SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem } from \"#lib/components/ui/sidebar/index.js\";\n\timport { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"#lib/components/ui/collapsible/index.js\";\n\timport { ChevronRightIcon, PlusIcon, EllipsisIcon } from \"@lucide/svelte\";\n\tconst { workspaces }: Props = $props();\n\t/** Workspaces that expand into their pages */\n\tinterface Props {\n\t\t/** Workspaces with an emoji and their pages */\n\t\tworkspaces: { name: string; emoji: string; pages: { name: string; url: string; emoji: string }[] }[];\n\t}\n</script>\n\n<SidebarGroup>\n\t<SidebarGroupLabel>Workspaces</SidebarGroupLabel>\n\t<SidebarGroupContent>\n\t\t<SidebarMenu>\n\t\t\t{#each workspaces as workspace (workspace.name)}\n\t\t\t\t<SidebarMenuItem>\n\t\t\t\t\t<Collapsible>\n\t\t\t\t\t\t<SidebarMenuButton href=\"#\">\n\t\t\t\t\t\t\t<span>{workspace.emoji}</span>\n\t\t\t\t\t\t\t<span>{workspace.name}</span>\n\t\t\t\t\t\t</SidebarMenuButton>\n\n\t\t\t\t\t\t<!-- On hover, a chevron over the emoji expands the pages, and a plus adds one. -->\n\t\t\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t\t\t{#snippet trigger({ props })}\n\t\t\t\t\t\t\t\t<SidebarMenuAction showOnHover class=\"workspaceToggle\" aria-label=\"Toggle {workspace.name}\" {...props}><ChevronRightIcon /></SidebarMenuAction>\n\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t\t\t<SidebarMenuAction showOnHover aria-label=\"Add a page to {workspace.name}\"><PlusIcon /></SidebarMenuAction>\n\t\t\t\t\t\t<CollapsibleContent>\n\t\t\t\t\t\t\t<SidebarMenuSub>\n\t\t\t\t\t\t\t\t{#each workspace.pages as page (page.name)}\n\t\t\t\t\t\t\t\t\t<SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t\t\t<SidebarMenuSubButton href={page.url}>\n\t\t\t\t\t\t\t\t\t\t\t<span>{page.emoji}</span>\n\t\t\t\t\t\t\t\t\t\t\t<span>{page.name}</span>\n\t\t\t\t\t\t\t\t\t\t</SidebarMenuSubButton>\n\t\t\t\t\t\t\t\t\t</SidebarMenuSubItem>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t</SidebarMenuSub>\n\t\t\t\t\t\t</CollapsibleContent>\n\t\t\t\t\t</Collapsible>\n\t\t\t\t</SidebarMenuItem>\n\t\t\t{/each}\n\n\t\t\t<!-- Muted link to the rest of the workspaces. -->\n\t\t\t<SidebarMenuItem>\n\t\t\t\t<SidebarMenuButton class=\"moreButton\">\n\t\t\t\t\t<EllipsisIcon />\n\t\t\t\t\t<span>More</span>\n\t\t\t\t</SidebarMenuButton>\n\t\t\t</SidebarMenuItem>\n\t\t</SidebarMenu>\n\t</SidebarGroupContent>\n</SidebarGroup>\n\n<style>\n\t/* The toggle covers the emoji on the start edge, and points down while open */\n\t:global(.sidebar .sidebarMenuAction.workspaceToggle) {\n\t\tright: auto;\n\t\tleft: var(--spacing-sm);\n\t\ttransition-property: color, background-color, box-shadow, opacity, transform;\n\t\tbackground-color: var(--sidebar-accent);\n\t\tcolor: var(--sidebar-accent-foreground);\n\t}\n\n\t:global(.sidebar .sidebarMenuAction.workspaceToggle[aria-expanded=\"true\"]) {\n\t\ttransform: rotate(90deg);\n\t}\n\n\t:global(.sidebar .sidebarMenuButton.moreButton) {\n\t\tcolor: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent);\n\t}\n</style>\n"
        },
